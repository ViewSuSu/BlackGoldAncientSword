<Window
    x:Class="BlackGoldAncientSword.App.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:consts="clr-namespace:BlackGoldAncientSword.Framework.Core.Consts;assembly=BlackGoldAncientSword.Framework"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:ext="clr-namespace:BlackGoldAncientSword.Framework.Core.Extensions;assembly=BlackGoldAncientSword.Framework"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:shell="clr-namespace:BlackGoldAncientSword.App.Shell"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    Title="{DynamicResource App.Title}"
    Width="1081"
    Height="727"
    d:DataContext="{d:DesignInstance Type=shell:MainWindowViewModel}"
    d:Icon="/BlackGoldAncientSword.Resources;component/Images/app.ico"
    d:Title="{DynamicResource App.Title}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    AllowsTransparency="True"
    Background="Transparent"
    Icon="/BlackGoldAncientSword.Resources;component/Images/app.ico"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ext:WindowIconConverter x:Key="WindowIconConverter" />
    </Window.Resources>
    <chrome:WindowChrome.WindowChrome>
        <chrome:WindowChrome
            x:Name="MainWindowChrome"
            CaptionHeight="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="4" />
    </chrome:WindowChrome.WindowChrome>

    <Grid>
        <Border
            Background="{DynamicResource SurfaceGradientBrush}"
            ClipToBounds="True"
            CornerRadius="10" Effect="{DynamicResource ShadowElevatedEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>

                <!--  ==================== Row 0: Title bar ====================  -->

                <!--  Title bar background  -->
                <Grid Grid.Row="0">
                <Border Background="{DynamicResource TitleBarGradientBrush}" MouseDown="TitleBar_MouseDown" />
                <!--  Decorative gradient accent line + gold shimmer trace  -->
                <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentGradientBrush}" Opacity="0.9" />
                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource GoldTraceGradientBrush}" Opacity="0.65" />
            </Grid>

                <!--  Window icon + title  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="13"
                        Height="13"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="ToolTip" Value="{DynamicResource TitleBar.Back}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanGoBack}" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:InvokeCommandAction Command="{Binding GoBackCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Image Source="/BlackGoldAncientSword.Resources;component/Images/back.png" Stretch="Uniform" />
                    </Button>
                    <Image
                        Width="18"
                        Margin="10,0,0,0"
                        Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WindowIconConverter}}"
                        Stretch="Uniform" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSize.Metadata}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSize.Metadata}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="——">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GameStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSize.Metadata}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{Binding GameStatusText, Mode=OneWay}" />
                </StackPanel>

                <!--  Custom title bar buttons  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Panel.ZIndex="9999"
                    Orientation="Horizontal">
                    <Button
                        Width="28"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MinimizeButton_Click"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="ToolTip" Value="{DynamicResource TitleBar.Minimize}" />
                            </Style>
                        </Button.Style>
                        <Image
                            Width="16"
                            Height="16"
                            Source="/BlackGoldAncientSword.Resources;component/Images/minimize.png"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        Width="28"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MaximizeButton_Click"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="ToolTip" Value="{DynamicResource TitleBar.Maximize}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="ToolTip" Value="{DynamicResource TitleBar.Restore}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Image
                            Width="16"
                            Height="16"
                            Source="/BlackGoldAncientSword.Resources;component/Images/maximize.png"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        Width="28"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="ToolTip" Value="{DynamicResource TitleBar.Close}" />
                            </Style>
                        </Button.Style>
                        <Image
                            Width="16"
                            Height="16"
                            Source="/BlackGoldAncientSword.Resources;component/Images/close.png"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <!--  Separator: Row 0 / Row 1  -->
                <Border
                    Grid.Row="0"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource BorderLightBrush}" />

                <!--  ==================== Row 1: Content area ====================  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" MinWidth="90" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Left sidebar  -->
                    <Border
                        Grid.Column="0"
                        Margin="0,10,0,0"
                        Padding="0"
                        Background="{DynamicResource SidebarGradientBrush}"
                        ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">

                                <!--  Home  -->
                                <Button ToolTip="{DynamicResource Nav.Home}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Height" Value="30" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="3,0,0,0" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActivePage}" Value="HomePage">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftGradientBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentGradientBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click">
                                            <i:InvokeCommandAction Command="{Binding NavigateToHomeCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0"
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="/BlackGoldAncientSword.Resources;component/Images/home.png"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource FontSize.Body}"
                                            Text="{DynamicResource Nav.Home}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>

                                <!--  Stats  -->
                                <Button ToolTip="{DynamicResource Nav.Stats}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Height" Value="30" />
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="3,0,0,0" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActivePage}" Value="StatsPage">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftGradientBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentGradientBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click">
                                            <i:InvokeCommandAction Command="{Binding NavigateToStatsCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0"
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="/BlackGoldAncientSword.Resources;component/Images/stats.png"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource FontSize.Body}"
                                            Text="{DynamicResource Nav.Stats}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>

                                <!--  Team Info  -->
                                <Button ToolTip="{DynamicResource TeamInfo.Title}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Height" Value="30" />
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="3,0,0,0" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActivePage}" Value="TeamInfoPage">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftGradientBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentGradientBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click">
                                            <i:InvokeCommandAction Command="{Binding NavigateToTeamInfoCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0"
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="/BlackGoldAncientSword.Resources;component/Images/team.png"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource FontSize.Body}"
                                            Text="{DynamicResource TeamInfo.Title}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>

                                <!--  测试三排（Debug-only）  -->
                                <Button
                                    ToolTip="测试三排（Debug）"
                                    Visibility="{Binding IsDebugBuild, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Height" Value="30" />
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="3,0,0,0" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActivePage}" Value="TestTrioPage">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftGradientBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentGradientBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click">
                                            <i:InvokeCommandAction Command="{Binding NavigateToTestTrioCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path
                                            Grid.Column="0"
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                                            Fill="{DynamicResource TextMutedBrush}"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource FontSize.Body}"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            Text="测试三排"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>

                                <!--  测试双排（Debug-only）  -->
                                <Button
                                    ToolTip="测试双排（Debug）"
                                    Visibility="{Binding IsDebugBuild, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Height" Value="30" />
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="3,0,0,0" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActivePage}" Value="TestDuoPage">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftGradientBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentGradientBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click">
                                            <i:InvokeCommandAction Command="{Binding NavigateToTestDuoCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path
                                            Grid.Column="0"
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                                            Fill="{DynamicResource TextMutedBrush}"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource FontSize.Body}"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            Text="测试双排"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <StackPanel
                                Grid.Row="1"
                                Margin="0,0,0,12"
                                VerticalAlignment="Bottom">

                                <!--  ==================== User avatar button + dock Popup ====================  -->
                                <!--  与网页版 .user-menu-trigger / .user-login-button 行为对齐：  -->
                                <!--  未登录 → 显示"登录"图标 + 文字 + 箭头，点击弹 QR Overlay  -->
                                <!--  已登录 → 显示 32×32 圆形头像，点击弹 Popup（头像 + 昵称 + 普通用户 + 退出登录）  -->
                                <Grid Margin="0,0,0,6">
                                    <!--  Logged-out login button  -->
                                    <Button
                                        Height="30"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="3,0,0,0"
                                        Command="{Binding UserProfile.OpenLoginCommand}"
                                        Cursor="Hand"
                                        ToolTip="{DynamicResource Auth.User.Login}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UserProfile.IsLoggedIn}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                            </Grid.ColumnDefinitions>
                                            <!--  Element Plus User icon (viewBox 0 0 1024 1024)  -->
                                            <Path
                                                Grid.Column="0"
                                                Width="14"
                                                Height="14"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M512 512a192 192 0 1 0 0-384 192 192 0 0 0 0 384m0 64a256 256 0 1 1 0-512 256 256 0 0 1 0 512m320 320v-96a96 96 0 0 0-96-96H288a96 96 0 0 0-96 96v96a32 32 0 1 1-64 0v-96a160 160 0 0 1 160-160h448a160 160 0 0 1 160 160v96a32 32 0 1 1-64 0"
                                                Fill="{DynamicResource TextPrimaryBrush}"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSize.Body}"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="{DynamicResource Auth.User.Login}"
                                                TextTrimming="CharacterEllipsis" />
                                            <!--  Element Plus ArrowRight icon  -->
                                            <Path
                                                Grid.Column="2"
                                                Width="10"
                                                Height="10"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M340.864 149.312a30.59 30.59 0 0 0 0 42.752L652.736 512 340.864 831.872a30.59 30.59 0 0 0 0 42.752 29.12 29.12 0 0 0 41.728 0L714.24 534.336a32 32 0 0 0 0-44.672L382.592 149.376a29.12 29.12 0 0 0-41.728 0z"
                                                Fill="{DynamicResource TextMutedBrush}"
                                                Stretch="Uniform" />
                                        </Grid>
                                    </Button>

                                    <!--  Logged-in avatar button (32×32 圆形，用 Ellipse 做遮罩)  -->
                                    <Button
                                        x:Name="UserAvatarButton"
                                        Height="30"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="3,0,0,0"
                                        Command="{Binding UserProfile.TogglePopupCommand}"
                                        Cursor="Hand"
                                        ToolTip="{Binding UserProfile.Nickname}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UserProfile.IsLoggedIn}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!--  32×32 圆形头像（在 24-wide 列中居中；Ellipse Fill 用 ImageBrush 天然做圆形 clip）  -->
                                            <Ellipse
                                                Grid.Column="0"
                                                Width="20"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Stroke="{DynamicResource BorderLightBrush}"
                                                StrokeThickness="1">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding UserProfile.AvatarUrl}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSize.Body}"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="{Binding UserProfile.Nickname}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>

                                    <!--  Popup 停靠：Placement=Top → 从头像按钮上方冒出，模拟网页 dropdown  -->
                                    <Popup
                                        AllowsTransparency="True"
                                        HorizontalOffset="8"
                                        IsOpen="{Binding UserProfile.IsPopupOpen, Mode=TwoWay}"
                                        Placement="Top"
                                        PlacementTarget="{Binding ElementName=UserAvatarButton}"
                                        PopupAnimation="Fade"
                                        StaysOpen="False"
                                        VerticalOffset="-4">
                                        <Border
                                            MinWidth="220"
                                            Padding="0"
                                            Background="{DynamicResource SurfaceGradientBrush}"
                                            BorderBrush="{DynamicResource BorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Effect="{DynamicResource ShadowElevatedEffect}">
                                            <StackPanel Orientation="Vertical">
                                                <!--  Profile card 展示区（disabled 视觉）  -->
                                                <Grid Margin="14,12,14,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse
                                                        Grid.Column="0"
                                                        Width="42"
                                                        Height="42"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Stroke="{DynamicResource BorderLightBrush}"
                                                        StrokeThickness="1">
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding UserProfile.AvatarUrl}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Orientation="Vertical">
                                                        <TextBlock
                                                            FontSize="{DynamicResource FontSize.Body}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                                            Text="{Binding UserProfile.Nickname}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Border
                                                            Margin="0,4,0,0"
                                                            Padding="6,2"
                                                            HorizontalAlignment="Left"
                                                            Background="{DynamicResource AccentSoftGradientBrush}"
                                                            CornerRadius="3">
                                                            <TextBlock
                                                                FontSize="{DynamicResource FontSize.Caption}"
                                                                Foreground="{DynamicResource AccentPrimaryBrush}"
                                                                Text="{DynamicResource Auth.User.RoleNormal}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!--  Divider  -->
                                                <Border Height="1" Background="{DynamicResource BorderLightBrush}" />

                                                <!--  Logout item (danger style, 电源图标)  -->
                                                <Button
                                                    Height="36"
                                                    Padding="14,0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding UserProfile.LogoutCommand}"
                                                    Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!--  Element Plus SwitchButton (电源图标) — Viewbox 缩放 1024×1024 到 14×14  -->
                                                        <Viewbox Width="14" Height="14">
                                                            <Canvas Width="1024" Height="1024">
                                                                <Path Data="M352 159.872V230.4a352 352 0 1 0 320 0v-70.528A416.128 416.128 0 0 1 512 960a416 416 0 0 1-160-800.128" Fill="#E85A5A" />
                                                                <Path Data="M512 64q32 0 32 32v320q0 32-32 32t-32-32V96q0-32 32-32" Fill="#E85A5A" />
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="{DynamicResource FontSize.Body}"
                                                            Foreground="#E85A5A"
                                                            Text="{DynamicResource Auth.User.Logout}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <Button ToolTip="{DynamicResource Nav.Settings}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Height" Value="30" />
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="3,0,0,0" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActivePage}" Value="SettingsPage">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftGradientBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentGradientBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click">
                                            <i:InvokeCommandAction Command="{Binding OpenSettingsCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0"
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="/BlackGoldAncientSword.Resources;component/Images/settings.png"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource FontSize.Body}"
                                            Text="{DynamicResource Nav.Settings}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>

                                <Button ToolTip="{DynamicResource Nav.Sponsor}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Height" Value="30" />
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="3,0,0,0" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </Style>
                                    </Button.Style>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click">
                                            <i:InvokeCommandAction Command="{Binding OpenSponsorCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Grid.Column="0"
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="/BlackGoldAncientSword.Resources;component/Images/sponsor.png"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource FontSize.Body}"
                                            Text="{DynamicResource Nav.Sponsor}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Grid splitter  -->
                    <GridSplitter
                        Grid.Column="1"
                        Width="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        ShowsPreview="True"
                        Style="{StaticResource ToolBarThumbHorizontalStyle}">
                        <GridSplitter.Template>
                            <ControlTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="0.2" />
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!--  Right content area  -->
                    <Grid Grid.Column="2">
                        <ContentControl prism:RegionManager.RegionName="{x:Static consts:GlobalConstant.MainContentRegion}" />
                    </Grid>
                </Grid>

                <!--  Separator: Row 1 / Row 2  -->
                <Border
                    Grid.Row="1"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource BorderLightBrush}" />

                <!--  ==================== Row 2: Bottom bar ====================  -->
                <StackPanel
                    Grid.Row="2"
                    Margin="12,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSize.Caption}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{Binding CurrentVersionText}" />
                    <!--  最新版本标记  -->
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSize.Caption}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{DynamicResource MainWindow.LatestVersion}"
                        Visibility="{Binding IsLatestVersion, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <!--  发现新版本  -->
                    <StackPanel
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Orientation="Horizontal"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding CheckForUpdatesCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <TextBlock
                            Margin="0,0,3,0"
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSize.Caption}"
                            Foreground="{DynamicResource AccentPrimaryBrush}"
                            Text="{DynamicResource Settings.UpdateAvailable}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                        <!--  更新日志  -->
                        <Button
                            Width="25"
                            Height="20"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="{DynamicResource MainWindow.ViewUpdateLog}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding OpenUpdateLogCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <Image
                                Width="15"
                                Height="15"
                                Source="/BlackGoldAncientSword.Resources;component/Images/update_log.png"
                                Stretch="Uniform" />
                        </Button>
                        <!--  联系作者  -->
                    <Grid>
                        <ToggleButton
                            x:Name="ContactToggle"
                            Width="25"
                            Height="20"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsChecked="{Binding IsContactPopupOpen}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Image
                                                        Width="15"
                                                        Height="15"
                                                        Source="/BlackGoldAncientSword.Resources;component/Images/contact.png"
                                                        Stretch="Uniform" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Popup
                            IsOpen="{Binding IsContactPopupOpen, Mode=TwoWay}"
                            AllowsTransparency="True"
                            HorizontalOffset="-80"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=ContactToggle}"
                            StaysOpen="False">
                            <Border
                                Background="{DynamicResource SurfaceSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Effect="{DynamicResource ShadowPopupEffect}">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="{DynamicResource FontSize.Body}"
                                        FontWeight="Bold"
                                        Text="{DynamicResource MainWindow.ContactAuthor}" />
                                    <TextBox
                                        MinWidth="160"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="{DynamicResource FontSize.Metadata}"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        IsReadOnly="True"
                                        Text="{DynamicResource MainWindow.WeChatInfo}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <!--  Feedback  -->
                    <Button
                        Width="25"
                        Height="20"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="{DynamicResource Nav.Feedback}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:InvokeCommandAction Command="{Binding OpenFeedbackCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Image
                            Width="15"
                            Height="15"
                            Source="/BlackGoldAncientSword.Resources;component/Images/feedback.png"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <!--  ==================== Overlays (span all rows) ====================  -->

                <!--  Announcement overlay (covers entire window, below toast)  -->
                <ContentControl
                    Grid.RowSpan="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Panel.ZIndex="10000"
                    x:Name="AnnouncementOverlay"
                    prism:RegionManager.RegionName="{x:Static consts:GlobalConstant.AnnouncementRegion}" />                <!--  Feedback overlay (covers entire window, below toast)  -->
                <ContentControl
                    Grid.RowSpan="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Panel.ZIndex="10000"
                    x:Name="FeedbackOverlay"
                    prism:RegionManager.RegionName="{x:Static consts:GlobalConstant.FeedbackRegion}" />

                <!--  Close prompt overlay (covers entire window, above announcement)  -->
                <ContentControl
                    Grid.RowSpan="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Panel.ZIndex="10050"
                    x:Name="ClosePromptOverlay"
                    prism:RegionManager.RegionName="{x:Static consts:GlobalConstant.ClosePromptRegion}" />

                <!--  Update notification overlay (covers entire window, above close prompt)  -->
                <ContentControl
                    Grid.RowSpan="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Panel.ZIndex="10060"
                    x:Name="UpdateNotificationOverlay"
                    prism:RegionManager.RegionName="{x:Static consts:GlobalConstant.UpdateNotificationRegion}" />

                <!--  Auth challenge overlay (login gate, highest of overlays)  -->
                <ContentControl
                    Grid.RowSpan="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Panel.ZIndex="10070"
                    x:Name="AuthChallengeOverlay"
                    prism:RegionManager.RegionName="{x:Static consts:GlobalConstant.AuthChallengeRegion}" />

                <!--  Startup gate overlay (Grid.Row=1 RowSpan=2 只挡内容+底栏，titlebar 露出保持最小化/关闭可用) -->
                <Border
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Panel.ZIndex="10090"
                    Background="#B0000000"
                    Focusable="True"
                    IsHitTestVisible="True"
                    Visibility="{Binding IsStartupBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Resources>
                        <Storyboard x:Key="StartupPulseStoryboard" RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="StartupCard"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.85" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Border.Resources>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource StartupPulseStoryboard}" />
                        </EventTrigger>
                    </Border.Triggers>
                    <Border x:Name="StartupCard"
                            Width="320" MinHeight="160"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Padding="24,22"
                            Background="{DynamicResource SurfaceGradientBrush}"
                            BorderBrush="{DynamicResource AccentPrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Effect="{DynamicResource ShadowElevatedEffect}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <hc:CircleProgressBar Width="52" Height="52"
                                                  ArcThickness="4"
                                                  Foreground="{DynamicResource AccentPrimaryBrush}"
                                                  IsIndeterminate="True" />
                            <TextBlock Margin="0,14,0,4"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Section}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{DynamicResource Startup.CheckingUpdates}" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{DynamicResource Startup.PleaseWait}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Border>

                <!--  Online updating overlay (Updater 独立进程正在下载+解压+覆盖，主 App 全域锁死等被 kill 后重启) -->
                <Border
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Panel.ZIndex="10100"
                    Background="#B0000000"
                    Focusable="True"
                    IsHitTestVisible="True"
                    Visibility="{Binding IsOnlineUpdating, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Resources>
                        <Storyboard x:Key="OnlineUpdatingPulseStoryboard" RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="OnlineUpdatingCard"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.85" To="1.0" Duration="0:0:0.9" AutoReverse="True">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Border.Resources>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource OnlineUpdatingPulseStoryboard}" />
                        </EventTrigger>
                    </Border.Triggers>
                    <Border x:Name="OnlineUpdatingCard"
                            Width="360" MinHeight="180"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Padding="26,24"
                            Background="{DynamicResource SurfaceGradientBrush}"
                            BorderBrush="{DynamicResource AccentPrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Effect="{DynamicResource ShadowElevatedEffect}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <hc:CircleProgressBar Width="60" Height="60"
                                                  ArcThickness="5"
                                                  Foreground="{DynamicResource AccentPrimaryBrush}"
                                                  IsIndeterminate="True" />
                            <TextBlock Margin="0,16,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Section}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{DynamicResource Startup.OnlineUpdating}" />
                        </StackPanel>
                    </Border>
                </Border>

                <!--  Battle detail overlay (below close prompt, above announcement)  -->
                <ContentControl
                    Grid.RowSpan="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Panel.ZIndex="10005"
                    x:Name="BattleDetailOverlay"
                    prism:RegionManager.RegionName="{x:Static consts:GlobalConstant.BattleDetailRegion}" />

                <!--  Sponsor overlay (below close prompt, above announcement)  -->
                <ContentControl
                    Grid.RowSpan="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Panel.ZIndex="10000"
                    x:Name="SponsorOverlay"
                    prism:RegionManager.RegionName="{x:Static consts:GlobalConstant.SponsorRegion}" />

                <!--  Update log overlay (below close prompt, above announcement)  -->
                <ContentControl
                    Grid.RowSpan="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Panel.ZIndex="10000"
                    x:Name="UpdateLogOverlay"
                    prism:RegionManager.RegionName="{x:Static consts:GlobalConstant.UpdateLogRegion}" />

            </Grid>
        </Border>

            <!--  Stacked toast notifications (topmost)  -->
            <ItemsControl
                Grid.RowSpan="3"
                Margin="0,60,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Panel.ZIndex="99999"
                IsHitTestVisible="False"
                ItemsSource="{Binding ToastItems}">
                <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                    x:Name="ToastItemBorder"
                    MaxWidth="500"
                    Margin="0,0,0,8"
                    Padding="16,10"
                    Background="#4CAF50"
                    BorderBrush="#388E3C"
                    BorderThickness="1"
                    CornerRadius="8"
                    Loaded="ToastItemBorder_Loaded"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0">
                    <Border.RenderTransform>
                        <TranslateTransform Y="-40" />
                    </Border.RenderTransform>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="{DynamicResource FontSize.Section}"
                        Foreground="White"
                        Text="{Binding Message}"
                        TextWrapping="Wrap" />
                    </Border>
                    <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsError}" Value="True">
                        <Setter TargetName="ToastItemBorder" Property="Background" Value="#F44336" />
                        <Setter TargetName="ToastItemBorder" Property="BorderBrush" Value="#D32F2F" />
                    </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        <!--  System tray icon (Hardcodet WPF NotifyIcon)  -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            IconSource="/BlackGoldAncientSword.Resources;component/Images/app.ico"
            MenuActivation="RightClick"
            ToolTipText="{DynamicResource App.Title}"
            TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Opened="TrayMenu_ContextMenu_Opened">
                    <MenuItem Header="{Binding GameStatusText}" IsEnabled="False">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GameStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <Separator />
                    <MenuItem Click="TrayMenu_Settings_Click" Header="{DynamicResource Nav.Settings}" />
                    <MenuItem Click="TrayMenu_Stats_Click" Header="{DynamicResource Nav.Stats}" />
                    <MenuItem Click="TrayMenu_TeamInfo_Click" Header="{DynamicResource TeamInfo.Title}" />
                    <!--  Language submenu  -->
                    <MenuItem Header="{DynamicResource Settings.Category.Language}">
                        <MenuItem StaysOpenOnClick="True">
                            <MenuItem.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="TrayLangZhCN" GroupName="TrayLanguageGroup" Click="TrayMenu_Language_Click" Width="20" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Text="中文简体" MouseLeftButtonDown="TrayMenu_ItemText_MouseLeftButtonDown" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem StaysOpenOnClick="True">
                            <MenuItem.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="TrayLangZhTW" GroupName="TrayLanguageGroup" Click="TrayMenu_Language_Click" Width="20" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Text="中文繁體" MouseLeftButtonDown="TrayMenu_ItemText_MouseLeftButtonDown" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem StaysOpenOnClick="True">
                            <MenuItem.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="TrayLangEn" GroupName="TrayLanguageGroup" Click="TrayMenu_Language_Click" Width="20" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Text="English" MouseLeftButtonDown="TrayMenu_ItemText_MouseLeftButtonDown" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                    </MenuItem>
                    <!--  Close Behavior submenu  -->
                    <MenuItem Header="{DynamicResource Settings.Category.CloseBehavior}">
                        <MenuItem StaysOpenOnClick="True">
                            <MenuItem.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="TrayCloseMinToTaskbar" GroupName="TrayCloseBehaviorGroup" Click="TrayMenu_CloseBehavior_Click" Width="20" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Settings.CloseBehavior.MinimizeToTaskbar}" MouseLeftButtonDown="TrayMenu_ItemText_MouseLeftButtonDown" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem StaysOpenOnClick="True">
                            <MenuItem.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="TrayCloseExitDirectly" GroupName="TrayCloseBehaviorGroup" Click="TrayMenu_CloseBehavior_Click" Width="20" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Settings.CloseBehavior.ExitDirectly}" MouseLeftButtonDown="TrayMenu_ItemText_MouseLeftButtonDown" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                        <Separator />
                        <MenuItem StaysOpenOnClick="True">
                            <MenuItem.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="TrayRememberCloseBehavior" Click="TrayMenu_RememberCloseBehavior_Click" Width="20" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Settings.CloseBehavior.RememberChoice}" MouseLeftButtonDown="TrayMenu_ItemText_MouseLeftButtonDown" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                    </MenuItem>
                    <Separator />
                    <MenuItem StaysOpenOnClick="True">
                        <MenuItem.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="TrayShowTeamOverlay" Click="TrayMenu_ShowTeamOverlay_Click" Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Settings.ShowTeamOverlayDuringHeroSelection}" MouseLeftButtonDown="TrayMenu_ItemText_MouseLeftButtonDown" />
                            </Grid>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator />
                    <MenuItem Click="TrayMenu_Exit_Click" Header="{DynamicResource TitleBar.Close}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
