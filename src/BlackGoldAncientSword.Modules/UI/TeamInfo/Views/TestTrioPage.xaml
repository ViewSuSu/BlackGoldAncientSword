<bases:UserControlBase
    x:Class="BlackGoldAncientSword.Modules.UI.TeamInfo.Views.TestTrioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bases="clr-namespace:BlackGoldAncientSword.Framework.Core.Bases.Views;assembly=BlackGoldAncientSword.Framework"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:BlackGoldAncientSword.Modules.UI.TeamInfo.ViewModels"
    xmlns:views="clr-namespace:BlackGoldAncientSword.Modules.UI.TeamInfo.Views"
    d:DataContext="{d:DesignInstance Type=viewmodels:TestTrioPageViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    FontFamily="Segoe UI"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题栏：调试标记 + 标题  -->
        <Border
            Grid.Row="0"
            Margin="10,8,10,10"
            Padding="14,10"
            Background="{DynamicResource SurfaceGradientBrush}"
            BorderBrush="{DynamicResource BorderMediumBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Effect="{DynamicResource ShadowCardEffect}">
            <StackPanel Orientation="Horizontal">
                <Border
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentSoftGradientBrush}"
                    CornerRadius="3">
                    <TextBlock
                        FontSize="{DynamicResource FontSize.Caption}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource AccentPrimaryBrush}"
                        Text="DEBUG" />
                </Border>
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSize.Section}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="测试三排" />
            </StackPanel>
        </Border>

        <!--  三张自包含卡片 + 卡片之间 diff 对比列；SharedSizeScope 让 diff 与卡片内统计行逐行对齐，
             diff 列用 1* 权重随窗口变宽同步增长  -->
        <Grid Grid.Row="1" Margin="10,0" Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!--  左卡：mock 数据  -->
            <views:TeamMemberCard
                Grid.Column="0"
                Member="{Binding Members[0]}"
                MemberIndex="0"
                StatItemsSource="{Binding StatRows}" />

            <!--  Diff 0↔1（mock vs 本地）  -->
            <views:TeamDiffColumn
                Grid.Column="1"
                DiffSide="Left"
                StatItemsSource="{Binding StatRows}"
                Visibility="{Binding HasDiffLeft, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  中卡：本地用户真实查询  -->
            <views:TeamMemberCard
                Grid.Column="2"
                Member="{Binding Members[1]}"
                MemberIndex="1"
                StatItemsSource="{Binding StatRows}" />

            <!--  Diff 1↔2（本地 vs mock）  -->
            <views:TeamDiffColumn
                Grid.Column="3"
                DiffSide="Right"
                StatItemsSource="{Binding StatRows}"
                Visibility="{Binding HasDiffRight, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  右卡：mock 数据  -->
            <views:TeamMemberCard
                Grid.Column="4"
                Member="{Binding Members[2]}"
                MemberIndex="2"
                StatItemsSource="{Binding StatRows}" />
        </Grid>
    </Grid>
</bases:UserControlBase>
