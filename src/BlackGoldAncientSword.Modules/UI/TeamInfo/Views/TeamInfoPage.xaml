<bases:UserControlBase
    x:Class="BlackGoldAncientSword.Modules.UI.TeamInfo.Views.TeamInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ext="clr-namespace:BlackGoldAncientSword.Framework.Core.Extensions;assembly=BlackGoldAncientSword.Framework"
    xmlns:bases="clr-namespace:BlackGoldAncientSword.Framework.Core.Bases.Views;assembly=BlackGoldAncientSword.Framework"
    xmlns:controls="clr-namespace:BlackGoldAncientSword.Framework.UI.Controls;assembly=BlackGoldAncientSword.Framework"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:BlackGoldAncientSword.Modules.UI.TeamInfo.ViewModels"
    xmlns:views="clr-namespace:BlackGoldAncientSword.Modules.UI.TeamInfo.Views"
    d:DataContext="{d:DesignInstance Type=viewmodels:TeamInfoPageViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    FontFamily="Segoe UI"
    mc:Ignorable="d">
    <Grid ext:PageTransitionBehavior.IsEnabled="True" RenderTransformOrigin="0.5,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="25" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="10,8,10,10"
            Padding="14,10"
            Background="{DynamicResource SurfaceGradientBrush}"
            BorderBrush="{DynamicResource BorderMediumBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Effect="{DynamicResource ShadowCardEffect}"
            Visibility="{Binding HasMember0, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid ext:PageTransitionBehavior.IsEnabled="True" RenderTransformOrigin="0.5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  赛季 + 排数 + 大类，与战绩页共用同一控件与选项源  -->
                <controls:SeasonFilterBar
                    Grid.Column="0"
                    Seasons="{Binding Seasons}"
                    SelectedSeason="{Binding SelectedSeason, Mode=TwoWay}"
                    SelectedTeamSize="{Binding SelectedTeamSize, Mode=TwoWay}"
                    SelectedCategory="{Binding SelectedCategory, Mode=TwoWay}" />
            </Grid>
        </Border>

        <Grid
            x:Name="MainContentGrid"
            Grid.Row="1"
            Margin="10,0"
            Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!--  三张自包含卡片（搜索框+头像段位+统计行）+ 卡片之间 diff 对比列；
                 SharedSizeScope 使 diff 列与卡片内统计行逐行对齐  -->
            <views:TeamMemberCard
                Grid.Column="0"
                Member="{Binding Member0}"
                MemberIndex="0"
                StatItemsSource="{Binding MergedStatRows}"
                Visibility="{Binding HasMember0, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  DiffLeft 对比列（Member0 vs Member1）  -->
            <views:TeamDiffColumn
                Grid.Column="1"
                DiffSide="Left"
                StatItemsSource="{Binding MergedStatRows}"
                Visibility="{Binding HasDiffLeft, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Member1 卡片（本地用户格，中间卡蓝色高亮由控件内 DataTrigger 处理）  -->
            <views:TeamMemberCard
                Grid.Column="2"
                Member="{Binding Member1}"
                MemberIndex="1"
                StatItemsSource="{Binding MergedStatRows}"
                Visibility="{Binding HasMember1, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  DiffRight 对比列（Member1 vs Member2）  -->
            <views:TeamDiffColumn
                Grid.Column="3"
                DiffSide="Right"
                StatItemsSource="{Binding MergedStatRows}"
                Visibility="{Binding HasDiffRight, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Member2 卡片  -->
            <views:TeamMemberCard
                Grid.Column="4"
                Member="{Binding Member2}"
                MemberIndex="2"
                StatItemsSource="{Binding MergedStatRows}"
                Visibility="{Binding HasMember2, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!--  Waiting overlay - covers entire page  -->
        <Border Grid.RowSpan="2" Background="{DynamicResource SurfaceSecondaryBrush}" Visibility="{Binding IsWaiting, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <hc:CircleProgressBar
                    Width="56"
                    Height="56"
                    ArcThickness="4"
                    Foreground="{DynamicResource AccentPrimaryBrush}"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    FontSize="{DynamicResource FontSize.Section}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding StatusText}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</bases:UserControlBase>
