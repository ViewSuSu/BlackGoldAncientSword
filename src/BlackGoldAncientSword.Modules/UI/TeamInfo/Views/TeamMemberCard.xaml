<UserControl
    x:Class="BlackGoldAncientSword.Modules.UI.TeamInfo.Views.TeamMemberCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:BlackGoldAncientSword.Modules.UI.TeamInfo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:BlackGoldAncientSword.Modules.UI.TeamInfo.ViewModels"
    x:Name="Root"
    d:DataContext="{d:DesignInstance Type=viewmodels:TeamMemberInfo}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  从合并统计行按卡片下标取列值（Val0/Val1/Val2）  -->
        <local:MergedStatValueConverter x:Key="MergedStatValueConverter" />
    </UserControl.Resources>

    <Border
        Padding="14,12"
        Background="{DynamicResource CardGradientBrush}"
        CornerRadius="10">
        <Border.Style>
            <!--  默认普通边框；本地用户格（中间卡）蓝色高亮边框。默认值须放 Style Setter，
                 否则局部值优先级高于触发器 Setter，高亮永不生效  -->
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderMediumBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Effect" Value="{DynamicResource ShadowCardEffect}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Member.IsLocalUser, ElementName=Root}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Effect" Value="{DynamicResource ShadowElevatedEffect}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <!--  搜索框区 / 头像段位区与宿主 Grid 的 diff 列共享行高，保证统计区垂直起始位置一致；
                     统计区（Row2）为 *，同宿主行内各控件自动等高  -->
                <RowDefinition Height="Auto" SharedSizeGroup="CardH0" />
                <RowDefinition Height="Auto" SharedSizeGroup="CardH1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ==================== Row 0: 详情入口 ====================  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="1"
                    Width="Auto"
                    Height="25"
                    Margin="8,0,0,0"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding Member.NavigateToStatsCommand, ElementName=Root}"
                    Cursor="Hand"
                    ToolTip="{DynamicResource TeamInfo.ViewPlayerStats}">
                    <TextBlock
                        FontSize="{DynamicResource FontSize.Metadata}"
                        Foreground="{DynamicResource AccentPrimaryBrush}"
                        Text="{DynamicResource Nav.Detail}"
                        TextDecorations="Underline" />
                </Button>
            </Grid>

            <!--  ==================== Row 1: 头像 + 段位 ====================  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Left: Avatar + Level + UID  -->
                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Border
                        Width="56"
                        Height="56"
                        Padding="2"
                        Background="{DynamicResource GoldRingGradientBrush}"
                        CornerRadius="28">
                        <Border
                            Background="{DynamicResource SurfaceTertiaryBrush}"
                            CornerRadius="26"
                            ClipToBounds="True">
                            <Border.Clip>
                                <EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26" />
                            </Border.Clip>
                            <Image
                                Width="52"
                                Height="52"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{Binding Member.AvatarUrl, ElementName=Root, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}}"
                                Stretch="UniformToFill" />
                        </Border>
                    </Border>
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="{DynamicResource FontSize.Body}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{Binding Member.DisplayName, ElementName=Root}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        FontSize="{DynamicResource FontSize.Caption}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{Binding Member.Level, ElementName=Root}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--  Right: Rank  -->
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Border
                        Width="80"
                        Height="80"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="5">
                        <Image
                            Width="80"
                            Height="80"
                            Source="{Binding Member.RankIcon, ElementName=Root, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}}"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSize.Section}"
                            FontWeight="SemiBold"
                            Text="{Binding Member.PageRankName, ElementName=Root}"
                            TextTrimming="CharacterEllipsis" />
                        <Image
                            Width="14"
                            Height="14"
                            Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            Source="pack://application:,,,/BlackGoldAncientSword.Resources;component/Images/star_icon.png"
                            Visibility="{Binding Member.PageHasStars, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource FontSize.Section}"
                            FontWeight="SemiBold"
                            Text="{Binding Member.PageStarCount, ElementName=Root}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding Member.PageHasStars, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        FontSize="{DynamicResource FontSize.Metadata}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextTrimming="CharacterEllipsis"><Run Text="{Binding Member.RankTierScore, ElementName=Root, StringFormat={}{0}}" /><Run Text="{DynamicResource Stats.Points}" /></TextBlock>
                </StackPanel>
            </Grid>

            <!--  ==================== Row 2: 统计行（卡片内部，按项数均分铺满） ====================  -->
            <ItemsControl
                Grid.Row="2"
                ItemsSource="{Binding StatItemsSource, ElementName=Root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1" Rows="{Binding StatCount, ElementName=Root}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14,0,14,0" BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="0,0,0,0.5">
                            <DockPanel>
                                <TextBlock VerticalAlignment="Center" DockPanel.Dock="Right"
                                           FontSize="{DynamicResource FontSize.Section}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource MergedStatValueConverter}">
                                            <Binding />
                                            <Binding ElementName="Root" Path="MemberIndex" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Metadata}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Loading overlay  -->
            <Border
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource SurfaceSecondaryBrush}"
                CornerRadius="8"
                Visibility="{Binding Member.IsLoading, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                <hc:CircleProgressBar
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ArcThickness="4"
                    Foreground="{DynamicResource AccentPrimaryBrush}"
                    IsIndeterminate="True" />
            </Border>

            <!--  Error overlay  -->
            <Border
                Grid.Row="0"
                Grid.RowSpan="2"
                Panel.ZIndex="10"
                Background="{DynamicResource SurfaceSecondaryBrush}"
                CornerRadius="8"
                Visibility="{Binding Member.HasStatusError, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSize.Section}"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{Binding Member.StatusText, ElementName=Root}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Border>
</UserControl>
