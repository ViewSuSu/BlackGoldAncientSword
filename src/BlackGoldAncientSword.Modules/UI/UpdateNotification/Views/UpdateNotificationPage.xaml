<bases:UserControlBase
    x:Class="BlackGoldAncientSword.Modules.UI.UpdateNotification.Views.UpdateNotificationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bases="clr-namespace:BlackGoldAncientSword.Framework.Core.Bases.Views;assembly=BlackGoldAncientSword.Framework"
    xmlns:consts="clr-namespace:BlackGoldAncientSword.Framework.Core.Consts;assembly=BlackGoldAncientSword.Framework"
    xmlns:ctrls="clr-namespace:BlackGoldAncientSword.Framework.UI.Controls;assembly=BlackGoldAncientSword.Framework"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">
    <ctrls:OverlayHost
        CardMaxWidth="560"
        CardMinWidth="420"
        RegionName="{x:Static consts:GlobalConstant.UpdateNotificationRegion}"
        Title="{DynamicResource UpdateNotification.Title}">

        <!--  整张卡片最高 540：内容超出自动出滚动条  -->
        <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  版本行  -->
                <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSize.Body}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{DynamicResource UpdateNotification.NewVersion}" />
                    <Border
                        Margin="6,0,0,0"
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentLightBrush}"
                        CornerRadius="3">
                        <TextBlock
                            FontSize="{DynamicResource FontSize.Metadata}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentPrimaryBrush}"
                            Text="{Binding LatestVersion}" />
                    </Border>
                </StackPanel>

                <!--  说明  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="{DynamicResource FontSize.Body}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="{DynamicResource UpdateNotification.Message}"
                    TextWrapping="Wrap" />

                <!--  下载链接：可点击打开浏览器下载最新版 Downloader.exe  -->
                <Border
                    Margin="0,0,0,12"
                    Padding="8,6"
                    Background="{DynamicResource SurfaceTertiaryBrush}"
                    CornerRadius="4"
                    Visibility="{Binding HasDownloadUrl, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        FontSize="{DynamicResource FontSize.Metadata}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTip="{Binding DownloadUrl}">
                        <Hyperlink Foreground="{DynamicResource AccentPrimaryBrush}" TextDecorations="Underline">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding OpenDownloadCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <Run Text="{Binding DownloadUrl, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                </Border>

                <!--  折叠的更新说明（release notes）  -->
                <Expander
                    Margin="0,0,0,14"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Header="{DynamicResource UpdateNotification.ReleaseNotesHeader}"
                    IsExpanded="False"
                    Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border
                        Margin="0,6,0,0"
                        Padding="10,8"
                        Background="{DynamicResource SurfaceTertiaryBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                FontFamily="Consolas, Microsoft YaHei UI"
                                FontSize="{DynamicResource FontSize.Metadata}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding ReleaseNotes}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Expander>

                <!--  操作按钮  -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Height="32"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Command="{Binding DismissCommand}"
                        Content="{DynamicResource UpdateNotification.Later}"
                        ToolTip="{DynamicResource UpdateNotification.Later}" />
                    <!--  在线更新：主 CTA。DropShadowEffect + Storyboard 让阴影发光 + 轻微缩放循环呼吸，抓用户视觉。  -->
                    <Button
                        Height="34"
                        MinWidth="120"
                        Padding="14,0"
                        Command="{Binding OnlineUpdateCommand}"
                        Content="{DynamicResource UpdateNotification.OnlineUpdate}"
                        Cursor="Hand"
                        FontSize="{DynamicResource FontSize.Body}"
                        FontWeight="Bold"
                        Foreground="White"
                        IsEnabled="{Binding CanOnlineUpdate}"
                        RenderTransformOrigin="0.5,0.5"
                        ToolTip="{DynamicResource UpdateNotification.OnlineUpdate.ToolTip}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#FF4A90E2" />
                                <GradientStop Offset="1" Color="#FF7B4FE0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Effect>
                            <DropShadowEffect
                                x:Name="OnlineUpdateGlow"
                                BlurRadius="14"
                                Direction="0"
                                Opacity="0.6"
                                ShadowDepth="0"
                                Color="#7B4FE0" />
                        </Button.Effect>
                        <Button.RenderTransform>
                            <ScaleTransform x:Name="OnlineUpdateScale" ScaleX="1" ScaleY="1" />
                        </Button.RenderTransform>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation
                                            Storyboard.TargetName="OnlineUpdateGlow"
                                            Storyboard.TargetProperty="BlurRadius"
                                            From="10"
                                            To="26"
                                            Duration="0:0:1.2" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="OnlineUpdateGlow"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0.45"
                                            To="0.95"
                                            Duration="0:0:1.2" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="OnlineUpdateScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            From="1"
                                            To="1.05"
                                            Duration="0:0:1.2" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="OnlineUpdateScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            From="1"
                                            To="1.05"
                                            Duration="0:0:1.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </ctrls:OverlayHost>
</bases:UserControlBase>
