<bases:UserControlBase
    x:Class="BlackGoldAncientSword.Modules.UI.UpdateNotification.Views.UpdateNotificationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bases="clr-namespace:BlackGoldAncientSword.Framework.Core.Bases.Views;assembly=BlackGoldAncientSword.Framework"
    xmlns:consts="clr-namespace:BlackGoldAncientSword.Framework.Core.Consts;assembly=BlackGoldAncientSword.Framework"
    xmlns:ctrls="clr-namespace:BlackGoldAncientSword.Framework.UI.Controls;assembly=BlackGoldAncientSword.Framework"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">
    <ctrls:OverlayHost
        CardMaxWidth="560"
        CardMinWidth="420"
        RegionName="{x:Static consts:GlobalConstant.UpdateNotificationRegion}"
        Title="{DynamicResource UpdateNotification.Title}">

        <!--  整张卡片最高 540：内容超出自动出滚动条  -->
        <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  版本行  -->
                <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="{DynamicResource UpdateNotification.NewVersion}" />
                    <Border
                        Margin="6,0,0,0"
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentLightBrush}"
                        CornerRadius="3">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentPrimaryBrush}"
                            Text="{Binding LatestVersion}" />
                    </Border>
                </StackPanel>

                <!--  说明  -->
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="13"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Text="{DynamicResource UpdateNotification.Message}"
                    TextWrapping="Wrap" />

                <!--  下载链接：可点击打开浏览器下载最新版 Downloader.exe  -->
                <Border
                    Margin="0,0,0,12"
                    Padding="8,6"
                    Background="{DynamicResource SurfaceTertiaryBrush}"
                    CornerRadius="4"
                    Visibility="{Binding HasDownloadUrl, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        FontSize="12"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTip="{Binding DownloadUrl}">
                        <Hyperlink Foreground="{DynamicResource AccentPrimaryBrush}" TextDecorations="Underline">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding OpenDownloadCommand}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <Run Text="{Binding DownloadUrl, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                </Border>

                <!--  折叠的更新说明（release notes）  -->
                <Expander
                    Margin="0,0,0,14"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Header="{DynamicResource UpdateNotification.ReleaseNotesHeader}"
                    IsExpanded="False"
                    Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border
                        Margin="0,6,0,0"
                        Padding="10,8"
                        Background="{DynamicResource SurfaceTertiaryBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                FontFamily="Consolas, Microsoft YaHei UI"
                                FontSize="12"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding ReleaseNotes}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Expander>

                <!--  操作按钮  -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Height="32"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Command="{Binding DismissCommand}"
                        Content="{DynamicResource UpdateNotification.Later}"
                        ToolTip="{DynamicResource UpdateNotification.Later}" />
                    <Button
                        Height="32"
                        MinWidth="100"
                        Command="{Binding OnlineUpdateCommand}"
                        Content="{DynamicResource UpdateNotification.OnlineUpdate}"
                        IsEnabled="{Binding CanOnlineUpdate}"
                        ToolTip="{DynamicResource UpdateNotification.OnlineUpdate.ToolTip}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </ctrls:OverlayHost>
</bases:UserControlBase>
