<bases:UserControlBase
    x:Class="BlackGoldAncientSword.Modules.UI.UpdateNotification.Views.UpdateNotificationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bases="clr-namespace:BlackGoldAncientSword.Framework.Core.Bases.Views;assembly=BlackGoldAncientSword.Framework"
    xmlns:consts="clr-namespace:BlackGoldAncientSword.Framework.Core.Consts;assembly=BlackGoldAncientSword.Framework"
    xmlns:ctrls="clr-namespace:BlackGoldAncientSword.Framework.UI.Controls;assembly=BlackGoldAncientSword.Framework"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">
    <ctrls:OverlayHost
        CardMaxWidth="520"
        CardMinWidth="380"
        RegionName="{x:Static consts:GlobalConstant.UpdateNotificationRegion}"
        Title="{DynamicResource UpdateNotification.Title}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Version line  -->
            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,12"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#333333"
                    Text="{DynamicResource UpdateNotification.NewVersion}" />
                <Border
                    Margin="6,0,0,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    Background="#E8F0FE"
                    CornerRadius="3">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#1A73E8"
                        Text="{Binding LatestVersion}" />
                </Border>
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,10"
                FontSize="13"
                Foreground="#333333"
                Text="{DynamicResource UpdateNotification.Message}"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="2"
                Margin="0,0,0,18"
                FontSize="12"
                TextWrapping="Wrap">
                <Hyperlink Foreground="#1A73E8" TextDecorations="Underline">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <i:InvokeCommandAction Command="{Binding OpenDownloadCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Run Text="{Binding DownloadUrl, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>

            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    MinWidth="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="{DynamicResource UpdateNotification.Later}"
                    Command="{Binding DismissCommand}"
                    ToolTip="{DynamicResource UpdateNotification.Later}" />
                <Button
                    MinWidth="120"
                    Height="32"
                    Command="{Binding OpenDownloadCommand}"
                    Content="{DynamicResource UpdateNotification.DownloadNow}"
                    ToolTip="{DynamicResource UpdateNotification.DownloadNow}" />
            </StackPanel>
        </Grid>
    </ctrls:OverlayHost>
</bases:UserControlBase>
