<bases:UserControlBase
    x:Class="BlackGoldAncientSword.Modules.UI.Stats.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bases="clr-namespace:BlackGoldAncientSword.Framework.Core.Bases.Views;assembly=BlackGoldAncientSword.Framework"
    xmlns:consts="clr-namespace:BlackGoldAncientSword.Framework.Core.Consts;assembly=BlackGoldAncientSword.Framework"
    xmlns:controls="clr-namespace:BlackGoldAncientSword.Framework.UI.Controls;assembly=BlackGoldAncientSword.Framework"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:BlackGoldAncientSword.Modules.UI.Stats.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:StatsPageViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    FontFamily="Segoe UI"
    mc:Ignorable="d">

    <Grid>
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <!--  === TOOLBAR: Search + Actions ===  -->
            <Grid Grid.Row="0" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <hc:SearchBar
                    Height="25"
                    VerticalAlignment="Center"
                    hc:InfoElement.Placeholder="{DynamicResource Search.Input}"
                    hc:TitleElement.Title="{DynamicResource Search.Title}"
                    hc:TitleElement.TitlePlacement="Left"
                    Command="{Binding SearchCommand}"
                    Style="{StaticResource SearchBarExtend}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Action buttons (right)  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Orientation="Horizontal">
                    <!--  Back to me button (hidden when viewing local user)  -->
                    <Button
                        Width="28"
                        Height="28"
                        Margin="6,0,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding GoBackToMeCommand}"
                        Cursor="Hand"
                        ToolTip="{DynamicResource Stats.BackToMe}"
                        ToolTipService.ShowOnDisabled="True">
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BlackGoldAncientSword.Resources;component/Images/back_to_me.png" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  === NOT FOUND OVERLAY ===  只覆盖内容区（保留顶部搜索栏 Row=0 供用户重新输入）  -->
            <Border
                Grid.Row="1"
                Grid.RowSpan="4"
                Panel.ZIndex="10"
                Background="{DynamicResource SurfaceSecondaryBrush}"
                Visibility="{Binding ShowNotFound, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSize.Title}"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{DynamicResource Stats.UserNotFound}" />
            </Border>

            <!--  === TOP: Player Info + Filters ===  -->
            <Grid Grid.Row="1">
                <StackPanel>
                    <StackPanel Margin="0,5,0,5">
                        <!--  Avatar - centered  金色渐变环 + 圆形头像 -->
                        <Border
                            Width="56"
                            Height="56"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource GoldRingGradientBrush}"
                            CornerRadius="28"
                            Padding="2">
                            <Border Background="{DynamicResource SurfaceTertiaryBrush}"
                                    CornerRadius="26" ClipToBounds="True">
                                <Border.Clip>
                                    <EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26" />
                                </Border.Clip>
                                <Image Width="52" Height="52"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="UniformToFill"
                                       Source="{Binding AvatarUrl, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}, ConverterParameter=112}" />
                            </Border>
                        </Border>

                        <!--  Level + Name - centered below avatar  -->
                        <StackPanel
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSize.Caption}"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="{Binding Level}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSize.Title}"
                                FontWeight="Bold"
                                Text="{Binding UserName}" />
                        </StackPanel>

                        <!--  UID - centered at bottom  -->
                        <StackPanel
                            Margin="0,2,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSize.Metadata}"
                                Foreground="{DynamicResource TextMutedBrush}">
                                <Run Text="UID: " /><Run Text="{Binding UID}" />
                            </TextBlock>
                            <Button
                                Width="16"
                                Height="16"
                                Margin="4,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding CopyUIDCommand}"
                                Cursor="Hand"
                                ToolTip="Copy UID">
                                <Path
                                    Width="10"
                                    Height="10"
                                    Data="M16 1H4C2.9 1 2 1.9 2 3V17H4V3H16V1ZM19 5H8C6.9 5 6 5.9 6 7V21C6 22.1 6.9 23 8 23H19C20.1 23 21 22.1 21 21V7C21 5.9 20.1 5 19 5ZM19 21H8V7H19V21Z"
                                    Fill="{DynamicResource TextMutedBrush}"
                                    Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>

                <!--  unified loading overlay (on top)  -->
                <Border
                    d:Visibility="Hidden"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    Visibility="{Binding IsPlayerInfoLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <hc:CircleProgressBar
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ArcThickness="4"
                        Foreground="{DynamicResource AccentPrimaryBrush}"
                        IsIndeterminate="True" />
                </Border>
            </Grid>



            <!--  === FILTERS + DETAIL STATS in rounded container ===  -->
            <Border
                Grid.Row="2"
                Margin="0,8,0,0"
                Padding="10"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="1"
                CornerRadius="5">
                <StackPanel>

                    <!--  === FILTERS ===  赛季 + 排数 + 大类，与队伍信息页共用同一控件与选项源  -->
                    <controls:SeasonFilterBar
                        Margin="0,0,0,12"
                        Seasons="{Binding Seasons}"
                        SelectedSeason="{Binding SelectedSeason, Mode=TwoWay}"
                        SelectedTeamSize="{Binding SelectedTeamSize, Mode=TwoWay}"
                        SelectedCategory="{Binding SelectedCategory, Mode=TwoWay}" />


                    <!--  === DETAIL STATS ===  -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{DynamicResource AccentBarStyle}" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="{DynamicResource FontSize.Section}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource Stats.DetailTitle}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Rank (left column)  -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Border
                                Width="100"
                                Height="100"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                CornerRadius="5">
                                <Image
                                    Width="100"
                                    Height="100"
                                    Source="{Binding RankIcon, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}, ConverterParameter=200}"
                                    Stretch="Uniform" />
                            </Border>
                            <!--  上行：段位名 + 折算星/子段数  -->
                            <StackPanel
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSize.Title}"
                                    FontWeight="SemiBold"
                                    Text="{Binding PageRankName}"
                                    TextWrapping="NoWrap" />
                                <Image
                                    Width="16"
                                    Height="16"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    Source="pack://application:,,,/BlackGoldAncientSword.Resources;component/Images/star_icon.png"
                                    Visibility="{Binding PageHasStars, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSize.Title}"
                                    FontWeight="SemiBold"
                                    Text="{Binding PageStarCount}"
                                    Visibility="{Binding PageHasStars, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <!--  下行：段位内分数  -->
                            <TextBlock
                                Margin="0,2,0,0"
                                HorizontalAlignment="Center"
                                FontSize="{DynamicResource FontSize.Body}"
                                Foreground="{DynamicResource TextMutedBrush}">
                                <Run Text="{Binding RankTierScore, StringFormat='{}{0}'}" /><Run Text="{DynamicResource Stats.Points}" />
                            </TextBlock>
                        </StackPanel>

                        <!--  Detail stats (right column)  -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding DetailStats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="3,0,3,6"
                                        Padding="10,0"
                                        BorderBrush="Gray"
                                        BorderThickness="0.2"
                                        CornerRadius="5">
                                        <DockPanel>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Right"
                                                FontSize="{DynamicResource FontSize.Section}"
                                                FontWeight="Bold"
                                                Text="{Binding Value}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSize.Caption}"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding Label}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Stats loading overlay  -->
                        <Border
                            Grid.ColumnSpan="2"
                            d:Visibility="Hidden"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            Visibility="{Binding IsStatsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <hc:CircleProgressBar
                                Width="64"
                                Height="64"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ArcThickness="4"
                                Foreground="{DynamicResource AccentPrimaryBrush}"
                                IsIndeterminate="True" />
                        </Border>
                    </Grid>

                </StackPanel>
            </Border>


            <Grid Grid.Row="3" Margin="0,20,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource AccentBarStyle}" />

                <!--  最近对局：模式筛选级联下拉（仿网页端）。默认按钮文字=当前筛选（无筛选时=“最近对局”）  -->
                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <ToggleButton
                        MinWidth="110"
                        Height="28"
                        Padding="10,0"
                        HorizontalContentAlignment="Left"
                        Background="{DynamicResource SurfaceTertiaryBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        IsChecked="{Binding IsBattleFilterOpen, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSize.Section}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding BattleFilterDisplayText}" />
                            <Path
                                Width="10"
                                Height="6"
                                Margin="8,2,0,0"
                                VerticalAlignment="Center"
                                Data="M0,0 L10,0 L5,6 Z"
                                Fill="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </ToggleButton>

                    <Popup
                        AllowsTransparency="True"
                        IsOpen="{Binding IsBattleFilterOpen, Mode=TwoWay}"
                        Placement="Bottom"
                        PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                        StaysOpen="False">
                        <!--  移出整个菜单区域时收起二级子菜单（清空悬停大类）  -->
                        <Border
                            Margin="0,4,0,0"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="4">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeave">
                                    <i:InvokeCommandAction Command="{Binding HoverBattleCategoryCommand}" CommandParameter="{x:Null}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <StackPanel>
                                <!--  重置项：回到无筛选（看全部）  -->
                                <Button
                                    MinWidth="140"
                                    Padding="12,6"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ResetBattleFilterCommand}"
                                    Content="{DynamicResource Stats.RecentBattles}"
                                    Cursor="Hand"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseEnter">
                                            <i:InvokeCommandAction Command="{Binding HoverBattleCategoryCommand}" CommandParameter="{x:Null}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </Button>
                                <Border
                                    Height="1"
                                    Margin="4,2"
                                    Background="{DynamicResource BorderLightBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  一级：大类（天选/匹配/天人）。悬停即展开右侧二级；点击=选中/再点取消。  -->
                                    <StackPanel Grid.Column="0" MinWidth="130">
                                        <Button
                                            Padding="12,6"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding SelectBattleCategoryCommand}"
                                            CommandParameter="{x:Static consts:GameModeCategory.Rank}"
                                            Cursor="Hand">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseEnter">
                                                    <i:InvokeCommandAction Command="{Binding HoverBattleCategoryCommand}" CommandParameter="{x:Static consts:GameModeCategory.Rank}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource GameMode.Rank}" />
                                                <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" Text="›" />
                                            </DockPanel>
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="Rank" Binding="{Binding SelectedBattleCategory}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                        <DataTrigger Value="Rank" Binding="{Binding HoveredBattleCategory}">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button
                                            Padding="12,6"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding SelectBattleCategoryCommand}"
                                            CommandParameter="{x:Static consts:GameModeCategory.Match}"
                                            Cursor="Hand">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseEnter">
                                                    <i:InvokeCommandAction Command="{Binding HoverBattleCategoryCommand}" CommandParameter="{x:Static consts:GameModeCategory.Match}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource GameMode.Match}" />
                                                <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" Text="›" />
                                            </DockPanel>
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="Match" Binding="{Binding SelectedBattleCategory}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                        <DataTrigger Value="Match" Binding="{Binding HoveredBattleCategory}">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button
                                            Padding="12,6"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding SelectBattleCategoryCommand}"
                                            CommandParameter="{x:Static consts:GameModeCategory.Tianren}"
                                            Cursor="Hand">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseEnter">
                                                    <i:InvokeCommandAction Command="{Binding HoverBattleCategoryCommand}" CommandParameter="{x:Static consts:GameModeCategory.Tianren}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource GameMode.Tianren}" />
                                                <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" Text="›" />
                                            </DockPanel>
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="Tianren" Binding="{Binding SelectedBattleCategory}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                        <DataTrigger Value="Tianren" Binding="{Binding HoveredBattleCategory}">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>

                                    <!--  二级：排数（三排/双排/单排）。仅当悬停到某一级大类时出现；点击=设排数/再点取消。  -->
                                    <StackPanel
                                        Grid.Column="1"
                                        MinWidth="90"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding IsBattleSubMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border
                                            Width="1"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource BorderLightBrush}"
                                            Visibility="Collapsed" />
                                        <Button
                                            Padding="12,6"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding SelectBattleTeamSizeCommand}"
                                            CommandParameter="{x:Static consts:TeamSize.Trio}"
                                            Content="{DynamicResource GameMode.Trio}"
                                            Cursor="Hand">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="Trio" Binding="{Binding SelectedBattleTeamSize}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button
                                            Padding="12,6"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding SelectBattleTeamSizeCommand}"
                                            CommandParameter="{x:Static consts:TeamSize.Duo}"
                                            Content="{DynamicResource GameMode.Duo}"
                                            Cursor="Hand">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="Duo" Binding="{Binding SelectedBattleTeamSize}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button
                                            Padding="12,6"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding SelectBattleTeamSizeCommand}"
                                            CommandParameter="{x:Static consts:TeamSize.Solo}"
                                            Content="{DynamicResource GameMode.Solo}"
                                            Cursor="Hand">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="Solo" Binding="{Binding SelectedBattleTeamSize}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
            <Grid Grid.Row="4">
                <DataGrid
                    d:ItemsSource="{d:SampleData}"
                    AutoGenerateColumns="False"
                    CanUserSortColumns="False"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding RecentBattles}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" Style="{DynamicResource ModernDataGridStyle}">
                    <DataGrid.Resources>
                        <!--  竹青圆角滚动条（局部样式，仅战绩页生效）  -->
                        <Style x:Key="ModernScrollThumbStyle" TargetType="{x:Type Thumb}">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Border
                                            x:Name="ThumbBd"
                                            Margin="2"
                                            Background="{DynamicResource AccentPrimaryBrush}"
                                            CornerRadius="4"
                                            Opacity="0.7" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ThumbBd" Property="Margin" Value="1" />
                                                <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                                <Setter TargetName="ThumbBd" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="ThumbBd" Property="Margin" Value="1" />
                                                <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                                                <Setter TargetName="ThumbBd" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <ControlTemplate x:Key="VertScrollBarTemplate" TargetType="{x:Type ScrollBar}">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="True"
                                       Maximum="{TemplateBinding Maximum}"
                                       Minimum="{TemplateBinding Minimum}"
                                       Orientation="{TemplateBinding Orientation}"
                                       Value="{TemplateBinding Value}"
                                       ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ModernScrollThumbStyle}" />
                                    </Track.Thumb>
                                </Track>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger SourceName="Bg" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>

                        <ControlTemplate x:Key="HorizScrollBarTemplate" TargetType="{x:Type ScrollBar}">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="True"
                                       Maximum="{TemplateBinding Maximum}"
                                       Minimum="{TemplateBinding Minimum}"
                                       Orientation="{TemplateBinding Orientation}"
                                       Value="{TemplateBinding Value}"
                                       ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="False" Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="False" Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ModernScrollThumbStyle}" />
                                    </Track.Thumb>
                                </Track>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger SourceName="Bg" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>

                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Width" Value="14" />
                            <Setter Property="MinWidth" Value="14" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Template" Value="{StaticResource VertScrollBarTemplate}" />
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Height" Value="14" />
                                    <Setter Property="MinHeight" Value="14" />
                                    <Setter Property="Template" Value="{StaticResource HorizScrollBarTemplate}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.ColumnHeaderStyle>
                        <Style BasedOn="{StaticResource ModernDataGridColumnHeaderStyle}" TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource ModernDataGridCellStyle}" TargetType="DataGridCell">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource ModernDataGridRowStyle}" TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="0.6*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.Rank}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.Rank}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
   <DataTemplate>
       <TextBlock
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Foreground="{DynamicResource TextMutedBrush}"
           Text="{Binding Rank}" />
   </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="170" Header="" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 英雄头像圆框 -->
                                        <Border Grid.Column="0" Width="30" Height="30"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{DynamicResource SurfaceTertiaryBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}"
                                                BorderThickness="1"
                                                CornerRadius="15" ClipToBounds="True">
                                            <Border.Clip>
                                                <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15" />
                                            </Border.Clip>
                                            <Image Width="30" Height="30"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Stretch="UniformToFill"
                                                   Source="{Binding HeroIcon, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}, ConverterParameter=64}" />
                                        </Border>
                                        <!-- 成就图标横向排列（放不下自动换行） -->
                                        <ItemsControl
                                            Grid.Column="1"
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            ItemsSource="{Binding HonorTitles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:DataGridWrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image
                                                        Width="26"
                                                        Height="26"
                                                        Margin="1"
                                                        VerticalAlignment="Center"
                                                        Source="{Binding Icon, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}, ConverterParameter=52}"
                                                        Stretch="Uniform">
                                                        <Image.ToolTip>
                                                            <ToolTip>
                                                                <StackPanel>
                                                                    <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                                                    <TextBlock Text="{Binding Desc}" />
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Image.ToolTip>
                                                    </Image>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.ModeCategory}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.ModeCategory}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding GameModeCategoryText}"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.ModeType}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.ModeType}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding GameModeTeamSizeText}"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="0.6*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.Kill}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.Kill}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding Kill}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="0.9*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.Damage}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.Damage}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding Damage}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1.8*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.RankScore}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.RankScore}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!--  段位整体居中：第一行 段位名+星，第二行 分数+分差，两行各自水平居中（与网页端一致）  -->
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsRankMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSize.Metadata}"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="{Binding RankDisplayText}" />
                                            <Image
                                                Width="14"
                                                Height="14"
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                Source="pack://application:,,,/BlackGoldAncientSword.Resources;component/Images/star_icon.png"
                                                Visibility="{Binding HasStars, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSize.Metadata}"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="{Binding StarCount}"
                                                Visibility="{Binding HasStars, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <StackPanel
                                            Margin="0,2,0,0"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSize.Caption}"
                                                FontWeight="ExtraLight"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding ScoreNumber}"
                                                Visibility="{Binding ShowScoreNumber, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSize.Metadata}"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding ScoreDiff, Converter={StaticResource ScoreDiffToColorConverter}}"
                                                Text="{Binding ScoreDiffDisplay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--  评级列 (S/A/B/C，与网页端一致)  -->
                        <DataGridTemplateColumn Width="0.7*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.Rating}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.Rating}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding Rating}"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1.2*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.Time}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.Time}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource FontSize.Caption}"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding BattleTime}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--  详情按钮列 (空标题, 固定宽)  -->
                        <DataGridTemplateColumn Width="50" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Height="22"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.OpenBattleDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="查看对局详情">
                                        <TextBlock
                                            FontSize="{DynamicResource FontSize.Metadata}"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            TextDecorations="Underline"
                                            Text="详情" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--  空结果提示：当前筛选下无对局（全量非空但过滤后为空）  -->
                <TextBlock
                    Margin="0,40,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontSize="{DynamicResource FontSize.Section}"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{DynamicResource Stats.NoBattleInMode}"
                    Visibility="{Binding HasNoBattleResult, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--  Recent battles loading overlay  -->
                <Border
                    d:Visibility="Hidden"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    Visibility="{Binding IsRecentBattlesLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <hc:CircleProgressBar
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ArcThickness="4"
                        Foreground="{DynamicResource AccentPrimaryBrush}"
                        IsIndeterminate="True" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</bases:UserControlBase>

