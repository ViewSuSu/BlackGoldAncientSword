<bases:UserControlBase
    x:Class="BlackGoldAncientSword.Modules.UI.Stats.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bases="clr-namespace:BlackGoldAncientSword.Framework.Core.Bases.Views;assembly=BlackGoldAncientSword.Framework"
    xmlns:controls="clr-namespace:BlackGoldAncientSword.Framework.UI.Controls;assembly=BlackGoldAncientSword.Framework"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:BlackGoldAncientSword.Modules.UI.Stats.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:StatsPageViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    FontFamily="Segoe UI"
    mc:Ignorable="d">

    <Grid>
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <!--  === TOOLBAR: Search + Actions ===  -->
            <Grid Grid.Row="0" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <hc:SearchBar
                    Height="25"
                    VerticalAlignment="Center"
                    hc:InfoElement.Placeholder="{DynamicResource Search.Input}"
                    hc:TitleElement.Title="{DynamicResource Search.Title}"
                    hc:TitleElement.TitlePlacement="Left"
                    Command="{Binding SearchCommand}"
                    Style="{StaticResource SearchBarExtend}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Action buttons (right)  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Orientation="Horizontal">
                    <!--  Refresh button  -->
                    <Button
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding RefreshAllCommand}"
                        Cursor="Hand"
                        ToolTip="{DynamicResource Stats.Refresh}">
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BlackGoldAncientSword.Resources;component/Images/refresh_data.png" />
                    </Button>

                    <!--  Back to me button (hidden when viewing local user)  -->
                    <Button
                        Width="28"
                        Height="28"
                        Margin="6,0,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding GoBackToMeCommand}"
                        Cursor="Hand"
                        ToolTip="{DynamicResource Stats.BackToMe}"
                        ToolTipService.ShowOnDisabled="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="True" />
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLocalUser}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BlackGoldAncientSword.Resources;component/Images/back_to_me.png" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  === NOT FOUND OVERLAY ===  只覆盖内容区（保留顶部搜索栏 Row=0 供用户重新输入）  -->
            <Border
                Grid.Row="1"
                Grid.RowSpan="4"
                Panel.ZIndex="10"
                Background="{DynamicResource SurfaceSecondaryBrush}"
                Visibility="{Binding ShowNotFound, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{DynamicResource Stats.UserNotFound}" />
            </Border>

            <!--  === TOP: Player Info + Filters ===  -->
            <Grid Grid.Row="1">
                <StackPanel>
                    <StackPanel Margin="0,5,0,5">
                        <!--  Avatar - centered  金色渐变环 + 圆形头像 -->
                        <Border
                            Width="56"
                            Height="56"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource GoldRingGradientBrush}"
                            CornerRadius="28"
                            Padding="2">
                            <Border Background="{DynamicResource SurfaceTertiaryBrush}"
                                    CornerRadius="26" ClipToBounds="True">
                                <Border.Clip>
                                    <EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26" />
                                </Border.Clip>
                                <Image Width="52" Height="52"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="UniformToFill"
                                       Source="{Binding AvatarUrl, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}}" />
                            </Border>
                        </Border>

                        <!--  Level + Name - centered below avatar  -->
                        <StackPanel
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="{Binding Level}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{Binding UserName}" />
                        </StackPanel>

                        <!--  UID - centered at bottom  -->
                        <StackPanel
                            Margin="0,2,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextMutedBrush}">
                                <Run Text="UID: " /><Run Text="{Binding UID}" />
                            </TextBlock>
                            <Button
                                Width="16"
                                Height="16"
                                Margin="4,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding CopyUIDCommand}"
                                Cursor="Hand"
                                ToolTip="Copy UID">
                                <Path
                                    Width="10"
                                    Height="10"
                                    Data="M16 1H4C2.9 1 2 1.9 2 3V17H4V3H16V1ZM19 5H8C6.9 5 6 5.9 6 7V21C6 22.1 6.9 23 8 23H19C20.1 23 21 22.1 21 21V7C21 5.9 20.1 5 19 5ZM19 21H8V7H19V21Z"
                                    Fill="{DynamicResource TextMutedBrush}"
                                    Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>

                <!--  unified loading overlay (on top)  -->
                <Border
                    d:Visibility="Hidden"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    Visibility="{Binding IsPlayerInfoLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <hc:CircleProgressBar
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ArcThickness="4"
                        Foreground="{DynamicResource AccentPrimaryBrush}"
                        IsIndeterminate="True" />
                </Border>
            </Grid>



            <!--  === FILTERS + DETAIL STATS in rounded container ===  -->
            <Border
                Grid.Row="2"
                Margin="0,8,0,0"
                Padding="10"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="1"
                CornerRadius="5">
                <StackPanel>

                    <!--  === FILTERS ===  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Season (left)  -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="{DynamicResource Stats.Season}" />
                            <ComboBox
                                Width="160"
                                Height="28"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Seasons}"
                                SelectedItem="{Binding SelectedSeason}" />
                        </StackPanel>

                        <!--  Team Size RadioButtons via ItemsControl  -->
                        <ItemsControl
                            Grid.Column="1"
                            Margin="20,0,0,0"
                            ItemsSource="{Binding TeamSizes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton
                                        Margin="0,0,12,0"
                                        CommandParameter="{Binding .}"
                                        Content="{Binding DisplayName}"
                                        GroupName="TeamSize">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="Click">
                                                <i:InvokeCommandAction Command="{Binding DataContext.SelectTeamSizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource EnumEqualityConverter}" Mode="OneWay">
                                                <Binding Path="Value" />
                                                <Binding Path="DataContext.SelectedTeamSize" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Category RadioButtons via ItemsControl (right)  -->
                        <ItemsControl Grid.Column="3" ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton
                                        Margin="0,0,12,0"
                                        CommandParameter="{Binding .}"
                                        Content="{Binding DisplayName}"
                                        GroupName="Category">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="Click">
                                                <i:InvokeCommandAction Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource EnumEqualityConverter}" Mode="OneWay">
                                                <Binding Path="Value" />
                                                <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>


                    <!--  === DETAIL STATS ===  -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{DynamicResource AccentBarStyle}" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource Stats.DetailTitle}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Rank (left column)  -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Border
                                Width="100"
                                Height="100"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                CornerRadius="5">
                                <Image
                                    Width="100"
                                    Height="100"
                                    Source="{Binding RankIcon, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}}"
                                    Stretch="Uniform" />
                            </Border>
                            <StackPanel
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding PageRankName}" />
                                <Image
                                    Width="16"
                                    Height="16"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    Source="pack://application:,,,/BlackGoldAncientSword.Resources;component/Images/star_icon.png"
                                    Visibility="{Binding PageHasStars, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding PageStarCount}"
                                    Visibility="{Binding PageHasStars, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,2,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextMutedBrush}">
                                    <Run Text="{Binding RankTierScore, StringFormat='{}{0}'}" /><Run Text="{DynamicResource Stats.Points}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!--  Detail stats (right column)  -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding DetailStats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="3,0,3,6"
                                        Padding="10,0"
                                        BorderBrush="Gray"
                                        BorderThickness="0.2"
                                        CornerRadius="5">
                                        <DockPanel>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Right"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Text="{Binding Value}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding Label}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Stats loading overlay  -->
                        <Border
                            Grid.ColumnSpan="2"
                            d:Visibility="Hidden"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            Visibility="{Binding IsStatsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <hc:CircleProgressBar
                                Width="64"
                                Height="64"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ArcThickness="4"
                                Foreground="{DynamicResource AccentPrimaryBrush}"
                                IsIndeterminate="True" />
                        </Border>
                    </Grid>

                </StackPanel>
            </Border>


            <Grid Grid.Row="3" Margin="0,20,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource AccentBarStyle}" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource Stats.RecentBattles}" />
            </Grid>
            <Grid Grid.Row="4">
                <DataGrid
                    d:ItemsSource="{d:SampleData}"
                    AutoGenerateColumns="False"
                    CanUserSortColumns="False"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding RecentBattles}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" Style="{DynamicResource ModernDataGridStyle}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style BasedOn="{StaticResource ModernDataGridColumnHeaderStyle}" TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource ModernDataGridCellStyle}" TargetType="DataGridCell">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource ModernDataGridRowStyle}" TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.Rank}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.Rank}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
   <DataTemplate>
       <TextBlock
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Foreground="{DynamicResource TextMutedBrush}"
           Text="{Binding Rank}" />
   </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="50" Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="30" Height="30"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceTertiaryBrush}"
                                            BorderBrush="{DynamicResource BorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="15" ClipToBounds="True">
                                        <Border.Clip>
                                            <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15" />
                                        </Border.Clip>
                                        <Image Width="30" Height="30"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Stretch="UniformToFill"
                                               Source="{Binding HeroIcon, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="75">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.ModeCategory}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.ModeCategory}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding GameModeCategoryText}"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="75">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.ModeType}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.ModeType}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding GameModeTeamSizeText}"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.Kill}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.Kill}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding Kill}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="65">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.Damage}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.Damage}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding Damage}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="140">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.RankScore}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.RankScore}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding IsRankMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Text="{Binding RankDisplayText}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Grid.RowSpan="2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Image
                                                Width="14"
                                                Height="14"
                                                Margin="2,0,0,0"
                                                VerticalAlignment="Center"
                                                Source="pack://application:,,,/BlackGoldAncientSword.Resources;component/Images/star_icon.png"
                                                Visibility="{Binding HasStars, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="{Binding StarCount}"
                                                Visibility="{Binding HasStars, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.RowSpan="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="3,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="ExtraLight"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding ScoreNumber}"
                                                Visibility="{Binding ShowScoreNumber, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding ScoreDiff, Converter={StaticResource ScoreDiffToColorConverter}}"
                                                Text="{Binding ScoreDiffDisplay}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="130">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.Time}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.Time}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding BattleTime}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--  详情按钮列 (空标题, 宽 40)  -->
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Height="22"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.OpenBattleDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="查看对局详情">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource AccentPrimaryBrush}"
                                            TextDecorations="Underline"
                                            Text="详情" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--  Recent battles loading overlay  -->
                <Border
                    d:Visibility="Hidden"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    Visibility="{Binding IsRecentBattlesLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <hc:CircleProgressBar
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ArcThickness="4"
                        Foreground="{DynamicResource AccentPrimaryBrush}"
                        IsIndeterminate="True" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</bases:UserControlBase>

