<bases:UserControlBase
    x:Class="BlackGoldAncientSword.Modules.UI.Stats.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bases="clr-namespace:BlackGoldAncientSword.Framework.Core.Bases.Views;assembly=BlackGoldAncientSword.Framework"
    xmlns:consts="clr-namespace:BlackGoldAncientSword.Framework.Core.Consts;assembly=BlackGoldAncientSword.Framework"
    xmlns:controls="clr-namespace:BlackGoldAncientSword.Framework.UI.Controls;assembly=BlackGoldAncientSword.Framework"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:BlackGoldAncientSword.Modules.UI.Stats.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:StatsPageViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    FontFamily="Segoe UI"
    mc:Ignorable="d">

    <Grid>
        <!--  整页竖向滚动：战绩区内容较高，窗口放不下时下方的对局列表会被裁掉看不见  -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!--  === TOOLBAR: Search + Actions ===  -->
            <Grid Grid.Row="0" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <hc:SearchBar
                        x:Name="SearchInput"
                        Height="25"
                        VerticalAlignment="Center"
                        hc:InfoElement.Placeholder="{DynamicResource Search.Input}"
                        hc:TitleElement.Title="{DynamicResource Search.Title}"
                        hc:TitleElement.TitlePlacement="Left"
                        Command="{Binding SearchCommand}"
                        PreviewKeyDown="OnSearchInputPreviewKeyDown"
                        Style="{StaticResource SearchBarExtend}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <!--
                        候选下拉：输入停顿 500ms 后自动出现（仿网页端的模糊搜索）。
                        列表开了虚拟化 + 像素滚动回收，只会为可见的几行生成容器；
                        往下滚接近底部时由 code-behind 的滚动事件追加下一页，不一次拉全量。
                    -->
                    <Popup
                        AllowsTransparency="True"
                        IsOpen="{Binding Suggestions.IsOpen, Mode=TwoWay}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=SearchInput}"
                        StaysOpen="False">
                        <Border
                            Width="{Binding ActualWidth, ElementName=SearchInput}"
                            MaxHeight="360"
                            Margin="0,4,0,0"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                            <Grid>
                                <ListBox
                                    x:Name="SuggestionList"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding Suggestions.Items}"
                                    ScrollViewer.CanContentScroll="True"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.ScrollChanged="OnSuggestionListScrollChanged"
                                    SelectedIndex="{Binding Suggestions.SelectedIndex, Mode=TwoWay}"
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.ScrollUnit="Pixel"
                                    VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!--
                                                点击走 Button 的 Command；项目禁用 MouseBinding（与 HandyControl 抢依赖属性）。
                                                Button 只负责铺满整行的点击区与背景，行内布局另起一层：HandyControl 的按钮模板
                                                把内容裹在横向 StackPanel 里，内容宽度是按文字量算的，右列起点会跟着左侧文字长度
                                                左右跑，段位图标对不齐。拆成两层后布局层铺满整行，右列位置才固定。
                                                Height / HorizontalAlignment 必须写成按钮上的本地值：HandyControl 给 Button
                                                的默认样式把高度固定成 28、并把它按内容宽度居中，不覆盖整行会被压成一条。
                                            -->
                                            <Grid>
                                                <Button
                                                    Height="Auto"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.SelectSuggestionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand" />

                                                <Grid Margin="10,8" IsHitTestVisible="False">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Grid.Column="0"
                                                        Width="36"
                                                        Height="36"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SurfaceTertiaryBrush}"
                                                        BorderBrush="{DynamicResource BorderLightBrush}"
                                                        BorderThickness="1"
                                                        ClipToBounds="True"
                                                        CornerRadius="18">
                                                        <Border.Clip>
                                                            <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18" />
                                                        </Border.Clip>
                                                        <Image
                                                            Width="36"
                                                            Height="36"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            RenderOptions.BitmapScalingMode="HighQuality"
                                                            Source="{Binding AvatarUrl, Mode=OneWay, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}, ConverterParameter=72}"
                                                            Stretch="UniformToFill" />
                                                    </Border>

                                                    <!--
                                                        中间一列两行贴左排布：昵称一行，其余字段一行。
                                                        第二行用 Wrap 而不是裁剪，接口多给的字段不会被吃掉。
                                                    -->
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="10,0,10,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="{DynamicResource FontSize.Section}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                                            Text="{Binding DisplayName, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />

                                                        <TextBlock
                                                            Margin="0,4,0,0"
                                                            FontSize="{DynamicResource FontSize.Caption}"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            Text="{Binding MetaText, Mode=OneWay}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <!--
                                                        右侧段位块：图标与左侧头像同尺寸；接口没给段位就整块不占位。
                                                        定宽是为了让图标左缘在每行都落在同一竖线上——宽度由文字撑的话，
                                                        段位名长短不同，图标就会左右跑。字号档位拉满时最长的一档也放得下，
                                                        名字再长就省略号收尾。
                                                    -->
                                                    <StackPanel
                                                        Grid.Column="2"
                                                        Width="130"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Visibility="{Binding HasRank, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Image
                                                            Width="36"
                                                            Height="36"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            RenderOptions.BitmapScalingMode="HighQuality"
                                                            Source="{Binding RankIconUrl, Mode=OneWay, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}, ConverterParameter=72}" />

                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="{DynamicResource FontSize.Caption}"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            Text="{Binding RankName, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock
                                    Margin="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSize.Caption}"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{DynamicResource Search.SuggestionsLoading}"
                                    Visibility="{Binding Suggestions.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <TextBlock
                                    Margin="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSize.Caption}"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{DynamicResource Search.SuggestionsEmpty}"
                                    Visibility="{Binding Suggestions.HasNoResult, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <Border
                                    Padding="0,3"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    Visibility="{Binding Suggestions.IsLoadingMore, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="{DynamicResource FontSize.Caption}"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{DynamicResource Search.SuggestionsLoadingMore}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <!--  Action buttons (right)  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Orientation="Horizontal">
                    <!--  Back to me button (hidden when viewing local user)  -->
                    <Button
                        Width="28"
                        Height="28"
                        Margin="6,0,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding GoBackToMeCommand}"
                        Cursor="Hand"
                        ToolTip="{DynamicResource Stats.BackToMe}"
                        ToolTipService.ShowOnDisabled="True">
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BlackGoldAncientSword.Resources;component/Images/back_to_me.png" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  === NOT FOUND OVERLAY ===  只覆盖内容区（保留顶部搜索栏 Row=0 供用户重新输入）  -->
            <Border
                Grid.Row="1"
                Grid.RowSpan="4"
                Panel.ZIndex="10"
                Background="{DynamicResource SurfaceSecondaryBrush}"
                Visibility="{Binding ShowNotFound, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSize.Title}"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{DynamicResource Stats.UserNotFound}" />
            </Border>

            <!--  === TOP: Player Info + Filters ===  -->
            <Grid Grid.Row="1">
                <StackPanel>
                    <StackPanel Margin="0,5,0,5">
                        <!--  Avatar - centered  金色渐变环 + 圆形头像 -->
                        <Border
                            Width="56"
                            Height="56"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource GoldRingGradientBrush}"
                            CornerRadius="28"
                            Padding="2">
                            <Border Background="{DynamicResource SurfaceTertiaryBrush}"
                                    CornerRadius="26" ClipToBounds="True">
                                <Border.Clip>
                                    <EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26" />
                                </Border.Clip>
                                <Image Width="52" Height="52"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="UniformToFill"
                                       Source="{Binding AvatarUrl, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}, ConverterParameter=112}" />
                            </Border>
                        </Border>

                        <!--  Level + Name - centered below avatar  -->
                        <StackPanel
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSize.Caption}"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="{Binding Level}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSize.Title}"
                                FontWeight="Bold"
                                Text="{Binding UserName}" />
                        </StackPanel>

                        <!--  UID - centered at bottom  -->
                        <StackPanel
                            Margin="0,2,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSize.Metadata}"
                                Foreground="{DynamicResource TextMutedBrush}">
                                <Run Text="UID: " /><Run Text="{Binding UID}" />
                            </TextBlock>
                            <Button
                                Width="16"
                                Height="16"
                                Margin="4,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding CopyUIDCommand}"
                                Cursor="Hand"
                                ToolTip="Copy UID">
                                <Path
                                    Width="10"
                                    Height="10"
                                    Data="M16 1H4C2.9 1 2 1.9 2 3V17H4V3H16V1ZM19 5H8C6.9 5 6 5.9 6 7V21C6 22.1 6.9 23 8 23H19C20.1 23 21 22.1 21 21V7C21 5.9 20.1 5 19 5ZM19 21H8V7H19V21Z"
                                    Fill="{DynamicResource TextMutedBrush}"
                                    Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>

                <!--  玩家信息加载遮罩（盖在最上层）  -->
                <Border
                    d:Visibility="Hidden"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    Visibility="{Binding IsPlayerInfoLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <hc:CircleProgressBar
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ArcThickness="4"
                        Foreground="{DynamicResource AccentPrimaryBrush}"
                        IsIndeterminate="True" />
                </Border>
            </Grid>



            <!--  === FILTERS + DETAIL STATS in rounded container ===  -->
            <Border
                Grid.Row="2"
                Margin="0,8,0,0"
                Padding="10"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="1"
                CornerRadius="5">
                <StackPanel>

                    <!--  === FILTERS ===  赛季 + 排数 + 大类，与队伍信息页共用同一控件与选项源  -->
                    <controls:SeasonFilterBar
                        Margin="0,0,0,12"
                        Seasons="{Binding Seasons}"
                        SelectedSeason="{Binding SelectedSeason, Mode=TwoWay}"
                        SelectedTeamSize="{Binding SelectedTeamSize, Mode=TwoWay}"
                        SelectedCategory="{Binding SelectedCategory, Mode=TwoWay}" />


                    <!--  === DETAIL STATS ===  -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{DynamicResource AccentBarStyle}" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="{DynamicResource FontSize.Section}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{DynamicResource Stats.DetailTitle}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Rank (left column)  -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Border
                                Width="100"
                                Height="100"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                CornerRadius="5">
                                <Image
                                    Width="100"
                                    Height="100"
                                    Source="{Binding RankIcon, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}, ConverterParameter=200}"
                                    Stretch="Uniform" />
                            </Border>
                            <!--  上行：段位名 + 折算星/子段数  -->
                            <StackPanel
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSize.Title}"
                                    FontWeight="SemiBold"
                                    Text="{Binding PageRankName}"
                                    TextWrapping="NoWrap" />
                                <Image
                                    Width="16"
                                    Height="16"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    Source="pack://application:,,,/BlackGoldAncientSword.Resources;component/Images/star_icon.png"
                                    Visibility="{Binding PageHasStars, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource FontSize.Title}"
                                    FontWeight="SemiBold"
                                    Text="{Binding PageStarCount}"
                                    Visibility="{Binding PageHasStars, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <!--  下行：官方积分原值（player_info.rating，如 3629）。未定级时整行隐藏  -->
                            <TextBlock
                                Margin="0,2,0,0"
                                HorizontalAlignment="Center"
                                FontSize="{DynamicResource FontSize.Body}"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Visibility="{Binding ShowRankScore, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{Binding RankScore, Mode=OneWay, StringFormat='{}{0}'}" /><Run Text="{DynamicResource Stats.Points}" />
                            </TextBlock>
                        </StackPanel>

                        <!--  Detail stats (right column)：
                              列数固定 3 列，行数由后端 overview[] 决定（有 N 项就渲染 N 格，后端加字段无需改这里）；
                              最后一行不足 3 项时留空，不做拉伸。后端没给数据时网格自然为空，不隐藏整块。
                              整块高度不固定：每行 25px，行数一变整块跟着长（UniformGrid 自己量算，无需写 Height）。  -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding DetailStats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" Rows="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--  行高固定 25：Width/Height 写在外层 Border 上（Grid 单元格里的元素只有显式
                                          尺寸才不会被 UniformGrid 均分拉伸）。Margin 会把描边一起缩进，故高度含上下边距。  -->
                                    <Border
                                        Height="25"
                                        Margin="3,0,3,6"
                                        Padding="10,0"
                                        BorderBrush="Gray"
                                        BorderThickness="0.2"
                                        CornerRadius="5">
                                        <DockPanel>
                                            <StackPanel
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Right"
                                                Orientation="Horizontal">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="{DynamicResource FontSize.Section}"
                                                    FontWeight="Bold"
                                                    Text="{Binding Value, Mode=OneWay}" />
                                                <!--  overview 的 S/A 角标：服务端没给评级（空串）时不渲染占位  -->
                                                <Border
                                                    Margin="4,0,0,0"
                                                    Padding="3,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentLightBrush}"
                                                    CornerRadius="3"
                                                    Visibility="{Binding HasGrade, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock
                                                        FontSize="{DynamicResource FontSize.Caption}"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource AccentPrimaryBrush}"
                                                        Text="{Binding Grade, Mode=OneWay}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSize.Caption}"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding Label, Mode=OneWay}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Stats loading overlay  -->
                        <Border
                            Grid.RowSpan="2"
                            Grid.ColumnSpan="2"
                            d:Visibility="Hidden"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            Visibility="{Binding IsStatsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <hc:CircleProgressBar
                                Width="64"
                                Height="64"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ArcThickness="4"
                                Foreground="{DynamicResource AccentPrimaryBrush}"
                                IsIndeterminate="True" />
                        </Border>
                    </Grid>

                </StackPanel>
            </Border>


            <Grid Grid.Row="3" Margin="0,20,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource AccentBarStyle}" />

                <!--  最近对局：模式筛选级联下拉（仿网页端）。默认按钮文字=当前筛选（无筛选时=“最近对局”）  -->
                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <ToggleButton
                        MinWidth="110"
                        Height="28"
                        Padding="10,0"
                        HorizontalContentAlignment="Left"
                        Background="{DynamicResource SurfaceTertiaryBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        IsChecked="{Binding IsBattleFilterOpen, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource FontSize.Section}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding BattleFilterDisplayText}" />
                            <Path
                                Width="10"
                                Height="6"
                                Margin="8,2,0,0"
                                VerticalAlignment="Center"
                                Data="M0,0 L10,0 L5,6 Z"
                                Fill="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </ToggleButton>

                    <Popup
                        AllowsTransparency="True"
                        IsOpen="{Binding IsBattleFilterOpen, Mode=TwoWay}"
                        Placement="Bottom"
                        PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                        StaysOpen="False">
                        <!--  移出整个菜单区域时收起二级子菜单（清空悬停大类）  -->
                        <Border
                            Margin="0,4,0,0"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="4">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeave">
                                    <i:InvokeCommandAction Command="{Binding HoverBattleCategoryCommand}" CommandParameter="{x:Null}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <StackPanel>
                                <!--  重置项：回到无筛选（看全部）  -->
                                <Button
                                    MinWidth="140"
                                    Padding="12,6"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ResetBattleFilterCommand}"
                                    Content="{DynamicResource Stats.RecentBattles}"
                                    Cursor="Hand"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseEnter">
                                            <i:InvokeCommandAction Command="{Binding HoverBattleCategoryCommand}" CommandParameter="{x:Null}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </Button>
                                <Border
                                    Height="1"
                                    Margin="4,2"
                                    Background="{DynamicResource BorderLightBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  一级：大类（天选/匹配/天人）。悬停即展开右侧二级；点击=选中/再点取消。  -->
                                    <StackPanel Grid.Column="0" MinWidth="130">
                                        <Button
                                            Padding="12,6"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding SelectBattleCategoryCommand}"
                                            CommandParameter="{x:Static consts:GameModeCategory.Rank}"
                                            Cursor="Hand">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseEnter">
                                                    <i:InvokeCommandAction Command="{Binding HoverBattleCategoryCommand}" CommandParameter="{x:Static consts:GameModeCategory.Rank}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource GameMode.Rank}" />
                                                <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" Text="›" />
                                            </DockPanel>
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="Rank" Binding="{Binding SelectedBattleCategory}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                        <DataTrigger Value="Rank" Binding="{Binding HoveredBattleCategory}">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>

                                    <!--  二级：排数（三排/双排/单排）。仅当悬停到某一级大类时出现；点击=设排数/再点取消。  -->
                                    <StackPanel
                                        Grid.Column="1"
                                        MinWidth="90"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding IsBattleSubMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border
                                            Width="1"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource BorderLightBrush}"
                                            Visibility="Collapsed" />
                                        <Button
                                            Padding="12,6"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding SelectBattleTeamSizeCommand}"
                                            CommandParameter="{x:Static consts:TeamSize.Trio}"
                                            Content="{DynamicResource GameMode.Trio}"
                                            Cursor="Hand">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="Trio" Binding="{Binding SelectedBattleTeamSize}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button
                                            Padding="12,6"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding SelectBattleTeamSizeCommand}"
                                            CommandParameter="{x:Static consts:TeamSize.Duo}"
                                            Content="{DynamicResource GameMode.Duo}"
                                            Cursor="Hand">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="Duo" Binding="{Binding SelectedBattleTeamSize}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button
                                            Padding="12,6"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding SelectBattleTeamSizeCommand}"
                                            CommandParameter="{x:Static consts:TeamSize.Solo}"
                                            Content="{DynamicResource GameMode.Solo}"
                                            Cursor="Hand">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="Solo" Binding="{Binding SelectedBattleTeamSize}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!--  近期场均名次（recent_avg_rank）  -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSize.Metadata}"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{Binding RecentAvgRankDisplay, Mode=OneWay}" />

                <!--  近期每局名次色块（recent_ranks）：第 1 名红、前五粉、其余灰  -->
                <ItemsControl
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="10,4,0,0"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding RecentRankBlocks}"
                    Visibility="{Binding HasRecentRanks, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="14"
                                Height="14"
                                Margin="1"
                                CornerRadius="2"
                                Cursor="Hand"
                                MouseLeftButtonDown="OnRankBlockClick"
                                ToolTip="{Binding Display, Mode=OneWay}">
                                <!--  点击走 code-behind 事件，不要换成 Border.InputBindings + MouseBinding：
                                     HandyControl 的 SimpleMouseBinding 会把名为 MouseAction 的依赖属性
                                     注册到 WPF 的 MouseBinding 类型上，两者只能存其一。一旦本程序里有任何
                                     地方用到 MouseBinding，HandyControl 主题里的 ToggleBlock 会在加载时抛
                                     XamlParseException，波及所有用到它的界面。  -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#4D4D4D" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Rank}" Value="1">
                                                <Setter Property="Background" Value="#E53935" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Rank}" Value="2">
                                                <Setter Property="Background" Value="#F06292" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Rank}" Value="3">
                                                <Setter Property="Background" Value="#F06292" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Rank}" Value="4">
                                                <Setter Property="Background" Value="#F06292" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Rank}" Value="5">
                                                <Setter Property="Background" Value="#F06292" />
                                            </DataTrigger>
                                            <!--  悬停加一圈描边表示可点：方框外径固定 14，只在内部让出 1px，不影响排版  -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderThickness" Value="1" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <!--  MinHeight：数据未到位时列表只有表头高，加载动画和空态提示会被压扁  -->
            <Grid Grid.Row="4" MinHeight="240">
                <DataGrid
                    x:Name="BattleGrid"
                    d:ItemsSource="{d:SampleData}"
                    AutoGenerateColumns="False"
                    PreviewMouseWheel="OnBattleGridPreviewMouseWheel"
                    CanUserSortColumns="False"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding RecentBattles}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" Style="{DynamicResource ModernDataGridStyle}">
                    <DataGrid.Resources>
                        <!--  竹青圆角滚动条（局部样式，仅战绩页生效）  -->
                        <Style x:Key="ModernScrollThumbStyle" TargetType="{x:Type Thumb}">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Border
                                            x:Name="ThumbBd"
                                            Margin="2"
                                            Background="{DynamicResource AccentPrimaryBrush}"
                                            CornerRadius="4"
                                            Opacity="0.7" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ThumbBd" Property="Margin" Value="1" />
                                                <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                                <Setter TargetName="ThumbBd" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="ThumbBd" Property="Margin" Value="1" />
                                                <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                                                <Setter TargetName="ThumbBd" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <ControlTemplate x:Key="VertScrollBarTemplate" TargetType="{x:Type ScrollBar}">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="True"
                                       Maximum="{TemplateBinding Maximum}"
                                       Minimum="{TemplateBinding Minimum}"
                                       Orientation="{TemplateBinding Orientation}"
                                       Value="{TemplateBinding Value}"
                                       ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ModernScrollThumbStyle}" />
                                    </Track.Thumb>
                                </Track>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger SourceName="Bg" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>

                        <ControlTemplate x:Key="HorizScrollBarTemplate" TargetType="{x:Type ScrollBar}">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="True"
                                       Maximum="{TemplateBinding Maximum}"
                                       Minimum="{TemplateBinding Minimum}"
                                       Orientation="{TemplateBinding Orientation}"
                                       Value="{TemplateBinding Value}"
                                       ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="False" Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="False" Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ModernScrollThumbStyle}" />
                                    </Track.Thumb>
                                </Track>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger SourceName="Bg" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>

                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Width" Value="14" />
                            <Setter Property="MinWidth" Value="14" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Template" Value="{StaticResource VertScrollBarTemplate}" />
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Height" Value="14" />
                                    <Setter Property="MinHeight" Value="14" />
                                    <Setter Property="Template" Value="{StaticResource HorizScrollBarTemplate}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.ColumnHeaderStyle>
                        <Style BasedOn="{StaticResource ModernDataGridColumnHeaderStyle}" TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource ModernDataGridCellStyle}" TargetType="DataGridCell">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource ModernDataGridRowStyle}" TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="0.6*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.Rank}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.Rank}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
   <DataTemplate>
       <TextBlock
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Foreground="{DynamicResource TextMutedBrush}"
           Text="{Binding Rank}" />
   </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="170" Header="" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 英雄头像圆框 -->
                                        <Border Grid.Column="0" Width="30" Height="30"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{DynamicResource SurfaceTertiaryBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}"
                                                BorderThickness="1"
                                                CornerRadius="15" ClipToBounds="True">
                                            <Border.Clip>
                                                <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15" />
                                            </Border.Clip>
                                            <Image Width="30" Height="30"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Stretch="UniformToFill"
                                                   Source="{Binding HeroIcon, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}, ConverterParameter=64}" />
                                        </Border>
                                        <!-- 成就图标横向排列（放不下自动换行） -->
                                        <ItemsControl
                                            Grid.Column="1"
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            ItemsSource="{Binding HonorTitles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:DataGridWrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image
                                                        Width="26"
                                                        Height="26"
                                                        Margin="1"
                                                        VerticalAlignment="Center"
                                                        Source="{Binding Icon, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}, ConverterParameter=52}"
                                                        Stretch="Uniform">
                                                        <Image.ToolTip>
                                                            <ToolTip>
                                                                <StackPanel>
                                                                    <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                                                    <TextBlock Text="{Binding Desc}" />
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Image.ToolTip>
                                                    </Image>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.ModeCategory}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.ModeCategory}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding GameModeCategoryText}"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.ModeType}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.ModeType}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding GameModeTeamSizeText}"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--  地图列：取 map_name 原值（scene 是官方残缺映射，不当地图名用）  -->
                        <DataGridTemplateColumn Width="1*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{Binding DataContext.MapColumnHeader, Mode=OneWay, RelativeSource={RelativeSource AncestorType=DataGrid}}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{Binding DataContext.MapColumnHeader, Mode=OneWay, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding MapName, Mode=OneWay}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="0.6*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.Kill}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.Kill}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding Kill}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="0.9*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.Damage}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.Damage}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding Damage}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1.8*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.RankScore}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.RankScore}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!--  段位整体居中：第一行 段位名+星，第二行 分数+分差，两行各自水平居中（与网页端一致）  -->
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsRankMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSize.Metadata}"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="{Binding RankDisplayText}" />
                                            <Image
                                                Width="14"
                                                Height="14"
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                Source="pack://application:,,,/BlackGoldAncientSword.Resources;component/Images/star_icon.png"
                                                Visibility="{Binding HasStars, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSize.Metadata}"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="{Binding StarCount}"
                                                Visibility="{Binding HasStars, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <StackPanel
                                            Margin="0,2,0,0"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSize.Caption}"
                                                FontWeight="ExtraLight"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding ScoreNumber}"
                                                Visibility="{Binding ShowScoreNumber, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource FontSize.Metadata}"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding ScoreDiff, Converter={StaticResource ScoreDiffToColorConverter}}"
                                                Text="{Binding ScoreDiffDisplay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--  评级列 (S/A/B/C，与网页端一致)  -->
                        <DataGridTemplateColumn Width="0.7*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.Rating}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.Rating}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding Rating}"
                                        TextAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1.2*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{DynamicResource Stats.Header.Time}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{DynamicResource Stats.Header.Time}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource FontSize.Caption}"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding BattleTime}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--  空结果提示：当前筛选下无对局（全量非空但过滤后为空）  -->
                <TextBlock
                    Margin="0,40,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontSize="{DynamicResource FontSize.Section}"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{DynamicResource Stats.NoBattleInMode}"
                    Visibility="{Binding HasNoBattleResult, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--  Recent battles loading overlay  -->
                <Border
                    d:Visibility="Hidden"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    Visibility="{Binding IsRecentBattlesLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <hc:CircleProgressBar
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ArcThickness="4"
                        Foreground="{DynamicResource AccentPrimaryBrush}"
                        IsIndeterminate="True" />
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</bases:UserControlBase>

