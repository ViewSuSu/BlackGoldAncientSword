<bases:UserControlBase
    x:Class="BlackGoldAncientSword.Modules.UI.Settings.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bases="clr-namespace:BlackGoldAncientSword.Framework.Core.Bases.Views;assembly=BlackGoldAncientSword.Framework"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    d:DesignHeight="400"
    d:DesignWidth="600"
    Background="WhiteSmoke"
    FontFamily="Segoe UI"
    mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="18"
            FontWeight="SemiBold"
            Text="{DynamicResource Settings.Title}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  Language  -->
                <GroupBox Style="{x:Null}" MinHeight="70" Padding="0,5,0,5">
                    <GroupBox.Header>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{DynamicResource Settings.Category.Language}" />
                    </GroupBox.Header>
                    <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding LanguageOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton
                                    Margin="0,0,20,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    CommandParameter="{Binding Code}"
                                    Content="{Binding DisplayName}"
                                    GroupName="Language">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click">
                                            <i:InvokeCommandAction Command="{Binding DataContext.SelectLanguageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Code}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource EnumEqualityConverter}" Mode="OneWay">
                                            <Binding Path="Code" />
                                            <Binding Path="DataContext.SelectedLanguage" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <!--  TeamOverlay  -->
                <GroupBox Margin="0,12,0,0" Style="{x:Null}" MinHeight="70" Padding="0,5,0,5">
                    <GroupBox.Header>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{DynamicResource Settings.Category.TeamOverlay}" />
                    </GroupBox.Header>
                    <StackPanel>
                        <CheckBox
                            Margin="0,4,0,4"
                            Content="{DynamicResource Settings.ShowTeamOverlayDuringHeroSelection}"
                            IsChecked="{Binding ShowTeamOverlayDuringHeroSelection}" />
                    </StackPanel>
                </GroupBox>

                <!--  General  -->
                <GroupBox Margin="0,12,0,0" Style="{x:Null}" MinHeight="70" Padding="0,5,0,5">
                    <GroupBox.Header>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{DynamicResource Settings.Category.General}" />
                    </GroupBox.Header>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Height="28"
                                Text="{Binding DataPath, UpdateSourceTrigger=LostFocus}" />
                            <Button
                                Grid.Column="1"
                                Width="32"
                                Height="28"
                                Margin="4,0,0,0"
                                Content="..." ToolTip="{DynamicResource Settings.BrowseDataPath}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click">
                                        <i:InvokeCommandAction Command="{Binding BrowseDataPathCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!--  Cache  -->
                <GroupBox Margin="0,12,0,0" Style="{x:Null}" MinHeight="70" Padding="0,5,0,5">
                    <GroupBox.Header>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{DynamicResource Settings.Category.Cache}" />
                    </GroupBox.Header>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Height="28"
                                Text="{Binding CachePath, UpdateSourceTrigger=LostFocus}" />
                            <Button
                                Grid.Column="1"
                                Width="32"
                                Height="28"
                                Margin="4,0,0,0"
                                Content="..." ToolTip="{DynamicResource Settings.BrowseCachePath}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click">
                                        <i:InvokeCommandAction Command="{Binding BrowseCachePathCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="Gray"
                                Text="{DynamicResource Settings.CacheSize}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding CacheSizeText}" />
                            <Button
                                Grid.Column="2"
                                MinWidth="80"
                                Height="28"
                                ToolTip="{DynamicResource Settings.ClearCache}" Content="{DynamicResource Settings.ClearCache}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click">
                                        <i:InvokeCommandAction Command="{Binding ClearCacheCommand}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <!--  Close Behavior  -->
                <GroupBox Margin="0,12,0,0" Style="{x:Null}" MinHeight="70" Padding="0,5,0,5">
                    <GroupBox.Header>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{DynamicResource Settings.Category.CloseBehavior}" />
                    </GroupBox.Header>
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="12"
                            Foreground="Gray"
                            Text="{DynamicResource Settings.CloseBehavior.Description}" />
                        <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding CloseBehaviorOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton
                                        Margin="0,0,20,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        CommandParameter="{Binding Value}"
                                        Content="{Binding DisplayName}"
                                        GroupName="CloseBehavior">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="Click">
                                                <i:InvokeCommandAction Command="{Binding DataContext.SelectCloseBehaviorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Value}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource EnumEqualityConverter}" Mode="OneWay">
                                                <Binding Path="Value" />
                                                <Binding Path="DataContext.SelectedCloseBehavior" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox
                            Margin="0,12,0,8"
                            Content="{DynamicResource Settings.CloseBehavior.RememberChoice}"
                            IsChecked="{Binding RememberCloseBehavior}" />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</bases:UserControlBase>

