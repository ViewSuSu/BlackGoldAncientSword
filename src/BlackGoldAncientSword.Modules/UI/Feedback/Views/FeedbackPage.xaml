<UserControl
    x:Class="BlackGoldAncientSword.Modules.UI.Feedback.Views.FeedbackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bases="clr-namespace:BlackGoldAncientSword.Framework.Core.Bases.Views;assembly=BlackGoldAncientSword.Framework"
    xmlns:consts="clr-namespace:BlackGoldAncientSword.Framework.Core.Consts;assembly=BlackGoldAncientSword.Framework"
    xmlns:ctrls="clr-namespace:BlackGoldAncientSword.Framework.UI.Controls;assembly=BlackGoldAncientSword.Framework"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">
    <ctrls:OverlayHost
        CardMaxWidth="500"
        CardPadding="20"
        RegionName="{x:Static consts:GlobalConstant.FeedbackRegion}"
        Title="{DynamicResource Feedback.Title}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                Grid.Row="0"
                MaxHeight="400"
                Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Feedback.ClientGroupTitle}" />
                    <TextBox
                        Margin="0,0,0,16"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="12"
                        Foreground="Gray"
                        IsReadOnly="True"
                        Text="{DynamicResource Feedback.ClientGroupQQ}" />

                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Feedback.DataGroupTitle}" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        Foreground="Gray"
                        Text="{DynamicResource Feedback.BotDescription}"
                        TextWrapping="Wrap" />
                    <TextBox
                        Margin="0,0,0,4"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="12"
                        Foreground="Gray"
                        IsReadOnly="True"
                        Text="{DynamicResource Feedback.DataGroup1}" />
                    <TextBox
                        Margin="0,0,0,4"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="12"
                        Foreground="Gray"
                        IsReadOnly="True"
                        Text="{DynamicResource Feedback.DataGroup2}" />
                    <TextBox
                        Margin="0,0,0,4"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="12"
                        Foreground="Gray"
                        IsReadOnly="True"
                        Text="{DynamicResource Feedback.DataGroup3}" />
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="11"
                        Foreground="#999999"
                        Text="{DynamicResource Feedback.QQEntryRequirement}"
                        TextWrapping="Wrap" />

                    <Separator Margin="0,8" />

                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Feedback.WebTitle}" />
                    <TextBlock Margin="0,0,0,12" FontSize="12">
                        <Hyperlink
                            Cursor="Hand"
                            Foreground="#4A90D9"
                            NavigateUri="https://naraka.drivod.top/"
                            RequestNavigate="Hyperlink_RequestNavigate">
                            https://naraka.drivod.top/
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Feedback.GitHubTitle}" />
                    <TextBlock FontSize="12">
                        <Hyperlink
                            Cursor="Hand"
                            Foreground="#4A90D9"
                            NavigateUri="https://github.com/ViewSuSu/BlackGoldAncientSword"
                            RequestNavigate="Hyperlink_RequestNavigate">
                            https://github.com/ViewSuSu/BlackGoldAncientSword
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    MinWidth="80"
                    Height="32"
                    Command="{Binding ConfirmCommand}"
                    Content="{DynamicResource Feedback.Close}" />
            </StackPanel>
        </Grid>
    </ctrls:OverlayHost>
</UserControl>
