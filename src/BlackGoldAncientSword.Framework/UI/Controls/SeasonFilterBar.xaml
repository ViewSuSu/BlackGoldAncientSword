<UserControl
    x:Class="BlackGoldAncientSword.Framework.UI.Controls.SeasonFilterBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:BlackGoldAncientSword.Framework.Core.Extensions"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:BlackGoldAncientSword.Framework.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  本地声明一份，避免依赖 App 合并字典的加载时序导致 StaticResource 解析失败  -->
        <ext:EnumEqualityConverter x:Key="EnumEqualityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  赛季下拉  -->
        <StackPanel Grid.Column="0" Orientation="Horizontal">
            <TextBlock
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                FontSize="{DynamicResource FontSize.Body}"
                Text="{DynamicResource Stats.Season}"
                TextTrimming="CharacterEllipsis" />
            <ComboBox
                Width="160"
                Height="25"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Seasons, ElementName=Root}"
                SelectedItem="{Binding SelectedSeason, ElementName=Root, Mode=TwoWay}" />
        </StackPanel>

        <!--  排数（三排/双排/单排）  -->
        <!--
            IsChecked 只做 OneWay 展示，选中值（SelectedTeamSize）是唯一真源：
            转换器按"选项值 == 当前选中值"驱动勾选，互斥天然成立，**不要**给 RadioButton 设 GroupName。
            注意两个实测事实（2026-09-19，最小 WPF 探针验证）：
            ① 无 GroupName 时 WPF 不会自动互斥同 ItemsControl 里的兄弟按钮（兄弟绑定保持 Active），
               互斥完全靠 DP 变化后绑定重新求值，这是预期行为；
            ② RadioButton.OnClick 会用 SetValue(IsChecked=true) 勾选自己，把这条 OneWay 绑定顶掉
               （绑定表达式变 null）——因此 Click 处理器写完 DP 后必须重建绑定（见 xaml.cs 的
               RestoreIsCheckedBinding），否则该按钮从此不跟随程序改值，界面出现"双勾"。
        -->
        <ItemsControl
            Grid.Column="1"
            Margin="20,0,0,0"
            ItemsSource="{x:Static local:SeasonFilterBar.TeamSizeOptions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton
                        Margin="0,0,12,0"
                        Click="OnTeamSizeClick"
                        Content="{Binding DisplayName}">
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{StaticResource EnumEqualityConverter}" Mode="OneWay">
                                <Binding Path="Value" />
                                <Binding ElementName="Root" Path="SelectedTeamSize" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  模式大类（天选/匹配/天人）  -->
        <ItemsControl Grid.Column="3" ItemsSource="{x:Static local:SeasonFilterBar.CategoryOptions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton
                        Margin="0,0,12,0"
                        Click="OnCategoryClick"
                        Content="{Binding DisplayName}">
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{StaticResource EnumEqualityConverter}" Mode="OneWay">
                                <Binding Path="Value" />
                                <Binding ElementName="Root" Path="SelectedCategory" />
                            </MultiBinding>
                        </RadioButton.IsChecked>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
