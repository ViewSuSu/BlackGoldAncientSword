<Window
    x:Class="BlackGoldAncientSword.Framework.UI.Controls.TeamOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BlackGoldAncientSword.Framework.UI.Controls"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="420"
    Height="Auto"
    MinHeight="210"
    MaxHeight="260"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <!-- 与主程序 ModernTheme 完全一致的青瓷竹青护眼浅色板 -->
        <!-- body = CardGradientBrush -->
        <LinearGradientBrush x:Key="OverlayCardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="1" Color="#FAFCF8" />
        </LinearGradientBrush>
        <!-- title/tool = TitleBarGradientBrush -->
        <LinearGradientBrush x:Key="OverlayTitleBarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FEFEFD" />
            <GradientStop Offset="1" Color="#F1F5EC" />
        </LinearGradientBrush>
        <!-- 描边 = BorderMediumBrush -->
        <SolidColorBrush x:Key="OverlayBorderBrush" Color="#96A88C" />
        <!-- 主字 = TextPrimaryBrush -->
        <SolidColorBrush x:Key="OverlayTextPrimary" Color="#1E241C" />
        <!-- 次字 = TextSecondaryBrush -->
        <SolidColorBrush x:Key="OverlayTextSecondary" Color="#42493F" />
        <!-- 弱字 = TextMutedBrush -->
        <SolidColorBrush x:Key="OverlayTextMuted" Color="#7E877A" />
        <!-- 头像底 = SurfaceTertiaryBrush -->
        <SolidColorBrush x:Key="OverlayAvatarBg" Color="#EEF2EA" />
    </Window.Resources>
    <Border
        Margin="8"
        Background="{StaticResource OverlayCardBrush}"
        BorderBrush="{StaticResource OverlayBorderBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                Color="#0E241A"
                Direction="270"
                Opacity="0.25"
                ShadowDepth="5" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Border Grid.Row="0"
                    Padding="14,8,10,8"
                    Background="{StaticResource OverlayTitleBarBrush}"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{StaticResource OverlayBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid x:Name="TitleBarGrid" MouseLeftButtonDown="TitleBarGrid_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 左侧金色小圆点 + 标题 -->
                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource GoldRingGradientBrush}" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource OverlayTextPrimary}"
                               Text="{DynamicResource TeamInfo.Title}" />
                    <TextBlock Grid.Column="2" Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI, Consolas"
                               FontSize="11"
                               Foreground="{StaticResource OverlayTextMuted}"
                               Text="{Binding CountdownText}" />
                    <Button Grid.Column="3"
                            Width="22" Height="22" Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding CloseCommand}"
                            Cursor="Hand"
                            ToolTip="{DynamicResource TitleBar.Close}">
                        <Path Width="10" Height="10"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M0,0 L10,10 M10,0 L0,10"
                              Stroke="{StaticResource OverlayTextSecondary}"
                              StrokeThickness="1.5" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============ 队员列表 ============ -->
            <ItemsControl Grid.Row="1"
                          Margin="10,10,10,6"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          d:ItemsSource="{d:SampleData}"
                          ItemsSource="{Binding Members}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type controls:TeamOverlayMemberItem}">
                        <StackPanel Margin="6,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 头像：金色渐变环 + 深墨底圆形 -->
                            <Border Width="44" Height="44"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource GoldRingGradientBrush}"
                                    CornerRadius="22" Padding="2">
                                <Border Background="{StaticResource OverlayAvatarBg}"
                                        CornerRadius="20" ClipToBounds="True">
                                    <Border.Clip>
                                        <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                                    </Border.Clip>
                                    <Image Width="40" Height="40"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding AvatarUrl, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}}" />
                                </Border>
                            </Border>
                            <!-- 玩家名 -->
                            <TextBlock Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource OverlayTextPrimary}"
                                       Text="{Binding UserName}"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- Loading -->
                            <hc:CircleProgressBar Width="36" Height="36" Margin="0,4,0,0"
                                                  HorizontalAlignment="Center"
                                                  ArcThickness="3"
                                                  Foreground="{DynamicResource GoldRingGradientBrush}"
                                                  IsIndeterminate="True"
                                                  Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <!-- Rank 内容 -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!-- 段位图标：金色细边 -->
                                <Border Margin="0,5,0,0"
                                        Width="36" Height="36"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource OverlayAvatarBg}"
                                        BorderBrush="{DynamicResource GoldRingGradientBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        ClipToBounds="True">
                                    <Image Width="34" Height="34"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding RankIcon, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}}"
                                           Stretch="Uniform" />
                                </Border>
                                <!-- 段位名 + 星 -->
                                <StackPanel Margin="0,3,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource OverlayTextSecondary}"
                                               Text="{Binding PageRankName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Image Width="12" Height="12" Margin="3,0,0,0"
                                           VerticalAlignment="Center"
                                           Source="pack://application:,,,/BlackGoldAncientSword.Resources;component/Images/star_icon.png"
                                           Visibility="{Binding PageHasStars, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="Segoe UI, Consolas"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource OverlayTextSecondary}"
                                               Text="{Binding PageStarCount}"
                                               Visibility="{Binding PageHasStars, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <!-- 分段分数 -->
                                <TextBlock Margin="0,2,0,0"
                                           HorizontalAlignment="Center"
                                           FontFamily="Segoe UI, Consolas"
                                           FontSize="10"
                                           Foreground="{StaticResource OverlayTextMuted}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding RankTierScore, StringFormat='{}{0}'}" /><Run Text="{DynamicResource Stats.Points}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ 底部工具栏 ============ -->
            <Border Grid.Row="2"
                    Padding="14,8,10,8"
                    Background="{StaticResource OverlayTitleBarBrush}"
                    BorderBrush="{StaticResource OverlayBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              BorderBrush="{StaticResource OverlayTextMuted}"
                              Content="{DynamicResource TeamOverlay.DontShowAgain}"
                              FontSize="11"
                              Foreground="{StaticResource OverlayTextSecondary}"
                              IsChecked="{Binding DontShowAgain}" />
                    <Button Grid.Column="2"
                            Height="22" Padding="8,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding NavigateToTeamInfoCommand}"
                            Cursor="Hand"
                            ToolTip="{DynamicResource TeamOverlay.ViewTeamInfo}">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GoldRingGradientBrush}"
                                   Text="{DynamicResource TeamOverlay.ViewTeamInfoButton}"
                                   TextDecorations="Underline" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
