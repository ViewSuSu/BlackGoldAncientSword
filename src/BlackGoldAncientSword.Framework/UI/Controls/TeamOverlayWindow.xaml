<Window
    x:Class="BlackGoldAncientSword.Framework.UI.Controls.TeamOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BlackGoldAncientSword.Framework.UI.Controls"
    Width="400"
    Height="150"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="True"
    ShowActivated="False"
    ResizeMode="NoResize"
    SnapsToDevicePixels="True">
    <Border
        Margin="8"
        Background="#2E2E2E"
        BorderBrush="#3A3A3A"
        BorderThickness="1"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="15"
                Direction="315"
                Opacity="0.35"
                ShadowDepth="3" />
        </Border.Effect>
        <Grid Margin="8,4,8,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Close button (top-right) -->
            <Button
                Grid.Row="0"
                Width="22"
                Height="22"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding CloseCommand}"
                Cursor="Hand"
                ToolTip="关闭">
                <Path
                    Width="10"
                    Height="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M0,0 L10,10 M10,0 L0,10"
                    Stroke="#888888"
                    StrokeThickness="1.5" />
            </Button>

            <!-- Team members area -->
            <ItemsControl
                Grid.Row="1"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ItemsSource="{Binding Members}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type controls:TeamOverlayMemberItem}">
                        <StackPanel
                            Width="100"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <!-- Avatar -->
                            <Border
                                Width="44"
                                Height="44"
                                HorizontalAlignment="Center"
                                Background="#3A3A3A"
                                CornerRadius="22"
                                BorderBrush="#555555"
                                BorderThickness="1">
                                <Image
                                    Width="40"
                                    Height="40"
                                    Source="{Binding AvatarUrl, IsAsync=True, Converter={StaticResource UrlToImageSourceConverter}}"
                                    RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <!-- Rank name -->
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="#B0B0B0"
                                Text="{Binding RankName}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- DontShowAgain checkbox (bottom-left) -->
            <CheckBox
                Grid.Row="2"
                Margin="4,0,0,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="Transparent"
                BorderBrush="#666666"
                Content="{DynamicResource TeamOverlay.DontShowAgain}"
                FontSize="11"
                Foreground="#999999"
                IsChecked="{Binding DontShowAgain}" />
        </Grid>
    </Border>
</Window>
