<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Authors>小窗同学</Authors>
    <PackageProjectUrl>https://github.com/ViewSuSu</PackageProjectUrl>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8601;CS8603;CA1416;CS8618</NoWarn>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    <!-- 控制 SourceGenerator 行为：Client 模式生成 DTO 与 NarakaApiClient -->
    <BgaSourceGenMode>Client</BgaSourceGenMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetSparkleUpdater.UI.WPF" Version="3.1.0" />
    <PackageReference Include="Prism.DryIoc" Version="8.1.97" />
    <PackageReference Include="HandyControl" Version="3.5.0" />
    <PackageReference Include="Mapster" Version="7.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlackGoldAncientSword.Framework.SourceGenerator\BlackGoldAncientSword.Framework.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Http\Definitions\**\*.json" />
  </ItemGroup>

  <!-- 让 SourceGenerator 通过 AnalyzerConfigOptionsProvider 读取自定义 MSBuild 属性 -->
  <ItemGroup>
    <CompilerVisibleProperty Include="BgaSourceGenMode" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlackGoldAncientSword.Tests" />
  </ItemGroup>
</Project>
