<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         ModernTheme — 淡雅护眼 · 青瓷竹青色板
         设计理念：护眼浅绿底 + 竹青深绿点缀 + 深墨字，东方雅致，长时间阅读舒适
         调整范围：仅调整已有 token 数值，未新增或改名任何 Key，保证兼容性
         ================================================================ -->

    <!-- ======================== 1. 语义色板 ======================== -->

    <!-- 表面层级 · 极淡雅护眼 -->
    <SolidColorBrush x:Key="SurfacePrimaryBrush"    Color="#F6F8F4" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush"  Color="#FDFEFC" />
    <SolidColorBrush x:Key="SurfaceTertiaryBrush"   Color="#EEF2EA" />
    <SolidColorBrush x:Key="SurfaceNavBrush"        Color="#FDFEFC" />
    <SolidColorBrush x:Key="SurfaceActiveBrush"     Color="#E6EEDF" />
    <SolidColorBrush x:Key="SurfaceSidebarBrush"    Color="#F1F5EC" />

    <!-- 强调色 · 柔和青草绿 -->
    <SolidColorBrush x:Key="AccentPrimaryBrush"     Color="#7EA089" />
    <SolidColorBrush x:Key="AccentHoverBrush"       Color="#6C8F77" />
    <SolidColorBrush x:Key="AccentPressedBrush"     Color="#587E65" />
    <SolidColorBrush x:Key="AccentLightBrush"       Color="#E6EEDF" />
    <SolidColorBrush x:Key="AccentSubtleBrush"      Color="#F0F5EA" />

    <!-- 功能色 · 中式配色 -->
    <SolidColorBrush x:Key="SuccessBrush"           Color="#3F8B57" />
    <SolidColorBrush x:Key="DangerBrush"            Color="#B23A3A" />
    <SolidColorBrush x:Key="WarningBrush"           Color="#C58B2B" />
    <SolidColorBrush x:Key="InfoBrush"              Color="#4E7CA0" />

    <!-- 文字色 · 深墨 -->
    <SolidColorBrush x:Key="TextPrimaryBrush"        Color="#1E241C" />
    <SolidColorBrush x:Key="TextSecondaryBrush"      Color="#42493F" />
    <SolidColorBrush x:Key="TextMutedBrush"          Color="#7E877A" />
    <SolidColorBrush x:Key="TextOnAccentBrush"       Color="#FBFDF9" />
    <SolidColorBrush x:Key="TextPlaceholderBrush"    Color="#B8C0B3" />

    <!-- 边框色 · 明显但柔和 -->
    <SolidColorBrush x:Key="BorderLightBrush"        Color="#B8C4AE" />
    <SolidColorBrush x:Key="BorderMediumBrush"       Color="#96A88C" />
    <SolidColorBrush x:Key="BorderFocusBrush"        Color="#7EA089" />

    <!-- ========== 渐变系统 · 克制、只作背景层，不夺按钮视觉焦点 ========== -->

    <!-- 主表面渐变 · 极浅垂直过渡 -->
    <LinearGradientBrush x:Key="SurfaceGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F7F9F5" />
        <GradientStop Offset="1" Color="#EFF4E9" />
    </LinearGradientBrush>

    <!-- 强调色渐变 · 供竖条 / 装饰用，柔和青草 -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#93B49D" />
        <GradientStop Offset="1" Color="#6C8F77" />
    </LinearGradientBrush>

    <!-- 侧边栏渐变 -->
    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F1F5EC" />
        <GradientStop Offset="1" Color="#E7EEE0" />
    </LinearGradientBrush>

    <!-- 标题栏渐变 · 白到淡绿的极轻过渡 -->
    <LinearGradientBrush x:Key="TitleBarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FEFEFD" />
        <GradientStop Offset="1" Color="#F1F5EC" />
    </LinearGradientBrush>

    <!-- 卡片渐变 · 近白，仅一丝层次 -->
    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#FAFCF8" />
    </LinearGradientBrush>

    <!-- 底部状态栏渐变 -->
    <LinearGradientBrush x:Key="StatusBarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F1F5EC" />
        <GradientStop Offset="1" Color="#E7EEE0" />
    </LinearGradientBrush>

    <!-- 强调色柔光渐变 · 用于选中态背景 -->
    <LinearGradientBrush x:Key="AccentSoftGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#E6EEDF" />
        <GradientStop Offset="1" Color="#D8E4CE" />
    </LinearGradientBrush>

    <!-- 深墨→竹青渐变 · 用于头像/英雄卡背景 -->
    <LinearGradientBrush x:Key="HeroCardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#243128" />
        <GradientStop Offset="1" Color="#3E6249" />
    </LinearGradientBrush>

    <!-- 装饰性金线渐变 · 顶栏细线用 -->
    <LinearGradientBrush x:Key="GoldTraceGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#00B8892B" />
        <GradientStop Offset="0.5" Color="#FFB8892B" />
        <GradientStop Offset="1" Color="#00B8892B" />
    </LinearGradientBrush>

    <!-- 头像/装备图标金色环渐变 · 温暖琥珀金，与竹青绿主题形成对比高光 -->
    <LinearGradientBrush x:Key="GoldRingGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E6C878" />
        <GradientStop Offset="0.5" Color="#B8892B" />
        <GradientStop Offset="1" Color="#7A5808" />
    </LinearGradientBrush>

    <!-- ======================== 2. 阴影效果 ======================== -->

    <!-- 卡片阴影 · 更深、更明显，配合可见边框 -->
    <DropShadowEffect x:Key="ShadowCardEffect"
        BlurRadius="14" Direction="270" Opacity="0.18"
        ShadowDepth="3" Color="#1A2E20" />

    <DropShadowEffect x:Key="ShadowElevatedEffect"
        BlurRadius="24" Direction="270" Opacity="0.25"
        ShadowDepth="5" Color="#0E241A" />

    <DropShadowEffect x:Key="ShadowPopupEffect"
        BlurRadius="34" Direction="270" Opacity="0.30"
        ShadowDepth="7" Color="#0A1D14" />

    <!-- 强调色发光 -->
    <DropShadowEffect x:Key="ShadowAccentEffect"
        BlurRadius="14" Direction="270" Opacity="0.30"
        ShadowDepth="0" Color="#5A8266" />

    <!-- ======================== 3. 全局圆角常量 ======================== -->
    <CornerRadius x:Key="RadiusNone">0</CornerRadius>
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>
    <CornerRadius x:Key="RadiusXl">14</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <!-- ======================== 4. 全局控件样式 ======================== -->

    <!-- 4a. 卡片容器边框 · 加粗至 1.5px + 明显边框色 -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Effect" Value="{StaticResource ShadowCardEffect}" />
    </Style>

    <!-- 4b. 面板（无阴影） -->
    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>

    <!-- 4c. 页面标题 -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 4d. 章节标题 -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 4e. 详情标签 -->
    <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Metadata}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!-- 4f. 详情数值 -->
    <Style x:Key="DetailValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 4g. 侧边栏按钮 -->
    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Margin="6,2"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource RadiusMd}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 4h. 现代按钮（主操作）· 竹青渐变 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource RadiusMd}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 4i. 现代按钮（次操作，带边框） -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderMediumBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource RadiusMd}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceTertiaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 4j. 图标按钮 -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource RadiusMd}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 4k. DataGrid 样式 -->
    <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderLightBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- 4l. DataGrid 列头样式 -->
    <Style x:Key="ModernDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{StaticResource SurfaceTertiaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Metadata}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- 4m. DataGrid 行样式 · 底边分隔线区分行 -->
    <Style x:Key="ModernDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentLightBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 4n. DataGrid 单元格样式 -->
    <Style x:Key="ModernDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 4o. 标题栏关闭按钮（悬停红色风格） -->
    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource RadiusSm}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F0D8D8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E2B8B8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 4p. 通用标题栏按钮（悬停灰色风格） -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource RadiusSm}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 4q. 扁平 GroupBox -->
    <Style x:Key="ModernGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="1"
                            Padding="16,14"
                            Background="{StaticResource CardGradientBrush}"
                            BorderBrush="{StaticResource BorderMediumBrush}"
                            BorderThickness="1.5"
                            CornerRadius="{StaticResource RadiusLg}"
                            Effect="{StaticResource ShadowCardEffect}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ContentPresenter
                                    Grid.Row="0"
                                    ContentSource="Header"
                                    Margin="0,0,0,8"
                                    TextElement.FontSize="{DynamicResource FontSize.Section}"
                                    TextElement.FontWeight="SemiBold"
                                    TextElement.Foreground="{StaticResource TextPrimaryBrush}" />
                                <ContentPresenter
                                    Grid.Row="1"
                                    Margin="0" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================== 5. 额外实用样式 ======================== -->

    <Style x:Key="StatusTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="StatValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="StatLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Metadata}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!-- ======================== 6. 装饰性样式 ======================== -->

    <!-- 章节标题装饰条 — 竹青渐变竖条 -->
    <Style x:Key="AccentBarStyle" TargetType="Border">
        <Setter Property="Width" Value="4" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Margin" Value="0,2,0,2" />
    </Style>

    <!-- 卡片顶部强调线 — 用于重要数据卡片 -->
    <SolidColorBrush x:Key="CardAccentTopBrush" Color="#7EA089" />
    <SolidColorBrush x:Key="CardAccentMiddleBrush" Color="#93B49D" />
    <SolidColorBrush x:Key="CardAccentRightBrush" Color="#587E65" />

    <!-- 对局详情 Tab 切换（RadioButton 变体，选中态为主色底 + 白字） -->
    <Style x:Key="DetailTabStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Padding" Value="0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Margin="3"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextElement.FontWeight="Medium"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPrimaryBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
