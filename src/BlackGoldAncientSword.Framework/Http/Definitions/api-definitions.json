          "code": { "type": "int" },
          "msg": { "type": "string" },
          "data": { "type": "UnifiedRecordSearchRes" }
        },
        "nestedTypes": {
          "UnifiedRecordSearchRes": {
            "type": "UnifiedRecordSearchRes",
            "properties": {
              "roleIdSimple": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
