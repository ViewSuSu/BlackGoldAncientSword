      "description": "搜索统一战绩用户：根据玩家名称或角色 ID 选择默认统一战绩数据源",
      "method": "GET",
      "path": "/app-api/record/unified/search",
      "queryParameters": {
        "name": "string",
        "source": "string"
      },
      "responseBody": {
        "type": "SearchRecordResponse",
