<Project Sdk="Microsoft.NET.Sdk">

  <!--
    设计原则：本项目独立，绝不引用 App / Framework / Modules 等主程序项目。
    原因：updater 解压完成后会全量覆盖安装目录里的文件，如果 updater 进程
    持有这些项目的 dll（DefaultLoadContext 锁定），文件覆盖会失败。

    发布建议：以 self-contained single-file 形式发布到安装目录，
    apphost 会把 runtime 抽取到 %TEMP%\.net，安装目录里除了 updater.exe 自身
    没有任何被锁定的 dll，可放心整目录覆盖。
  -->

  <PropertyGroup>
    <Authors>小窗同学</Authors>
    <PackageProjectUrl>https://github.com/ViewSuSu</PackageProjectUrl>
    <Company>$(Authors)</Company>
    <Description>BlackGoldAncientSword 在线更新程序</Description>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Images\updater.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0.0</Version>
    <AssemblyName>BlackGoldAncientSword.Update</AssemblyName>
    <RootNamespace>BlackGoldAncientSword.Update</RootNamespace>
  </PropertyGroup>

  <!-- 发布参数：CI/installer 调用 dotnet publish 时使用 -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      只引 NuGet 包，不引项目，保持 updater 独立。
      版本与主项目 Framework.csproj 保持一致：HandyControl 3.5.0。
    -->
    <PackageReference Include="HandyControl" Version="3.5.0" />
  </ItemGroup>

  <!--
    Updater 自带一份图标资源，与主程序视觉刻意区分（避免与 App 主程序共用同一图标）：
    - Images/updater.ico：🔄 更新循环箭头图标（Fluent Emoji, MIT）——窗口标题栏图标（Window.Icon）+ exe 文件图标（ApplicationIcon）
    - Images/close.png：右上角自绘关闭按钮图标
    设计上不引用 BlackGoldAncientSword.Resources 项目，保留 Updater 零项目引用的独立性。
  -->
 <ItemGroup>
   <Resource Include="Images\updater.ico" />
   <Resource Include="Images\close.png" />
 </ItemGroup>

 <!--
   生成后事件：将 Update 编译产物拷贝到 App 层对应配置的输出目录。
   确保开发/调试时 App 的输出目录中存在 Update.exe，便于测试更新流程。
 -->
 <Target Name="CopyUpdateToAppOutput" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
   <ItemGroup>
     <_UpdateOutput Include="$(TargetDir)$(AssemblyName).exe" />
     <_UpdateOutput Include="$(TargetDir)$(AssemblyName).dll" />
     <_UpdateOutput Include="$(TargetDir)$(AssemblyName).pdb" />
   </ItemGroup>
   <Copy SourceFiles="@(_UpdateOutput)"
          DestinationFolder="$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\BlackGoldAncientSword.App\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)'))"
         SkipUnchangedFiles="true"
         OverwriteReadOnlyFiles="true" />
 </Target>

</Project>
