<Project Sdk="Microsoft.NET.Sdk">

  <!--
    设计原则：本项目独立，绝不引用 App / Framework / Modules 等主程序项目。
    原因：updater 解压完成后会全量覆盖安装目录里的文件，如果 updater 进程
    持有这些项目的 dll（DefaultLoadContext 锁定），文件覆盖会失败。

    技术栈：Avalonia 11 + Native AOT。
    发布产物：单个原生 exe（无外部 dll、无 .NET Runtime 依赖），
    客户机零运行时依赖；目标体积远小于原 WPF self-contained 方案。
  -->

  <PropertyGroup>
    <Authors>小窗同学</Authors>
    <PackageProjectUrl>https://github.com/ViewSuSu</PackageProjectUrl>
    <Company>$(Authors)</Company>
    <Description>BlackGoldAncientSword 在线更新程序</Description>
    <OutputType>WinExe</OutputType>
    <!--
      TargetFramework 固定 net9.0：
        Avalonia 11.2.5 + Native AOT 官方测试矩阵覆盖 net8 / net9，
        net10.0 上启动 silent crash（实测 v1.0.0.0/v1.0.0.1）。
        Update 项目独立、不引用主 App（主 App 仍 net10.0-windows），
        两者 TargetFramework 不一致互不影响。
    -->
    <TargetFramework>net9.0</TargetFramework>
    <ApplicationIcon>..\BlackGoldAncientSword.Resources\Images\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0.0</Version>
    <AssemblyName>BlackGoldAncientSword.Update</AssemblyName>
    <RootNamespace>BlackGoldAncientSword.Update</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- Avalonia AOT 编译开关 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- 发布参数：CI/installer 调用 dotnet publish 时使用 -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Avalonia 11.x：跨平台 UI 框架。仅桌面 + Fluent 主题，
      不引 Avalonia.Diagnostics（DevTools），减体积。
    -->
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
  </ItemGroup>

</Project>
