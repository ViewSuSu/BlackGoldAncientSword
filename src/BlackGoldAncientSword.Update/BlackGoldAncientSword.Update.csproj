<Project Sdk="Microsoft.NET.Sdk">

  <!--
    设计原则：本项目独立，绝不引用 App / Framework / Modules 等主程序项目。
    原因：updater 解压完成后会全量覆盖安装目录里的文件，如果 updater 进程
    持有这些项目的 dll（DefaultLoadContext 锁定），文件覆盖会失败。

    技术栈：Avalonia 11 + .NET self-contained single-file。
    发布产物：单个 self-contained exe（apphost 启动时把 runtime 抽到 %TEMP%\.net，
    安装目录里除 updater.exe 自身没有任何被锁定的 dll，整目录覆盖安全）。

    历史：曾尝试 Native AOT（v1.0.0.0/v1.0.0.1），Avalonia 11.2.5 + net10.0 AOT
    启动 silent crash；降到 net9.0 AOT 仍未充分验证，遂回退到 self-contained 单文件，
    生产环境最稳。
  -->

  <PropertyGroup>
    <Authors>小窗同学</Authors>
    <PackageProjectUrl>https://github.com/ViewSuSu</PackageProjectUrl>
    <Company>$(Authors)</Company>
    <Description>BlackGoldAncientSword 在线更新程序</Description>
    <OutputType>WinExe</OutputType>
    <!--
      TargetFramework 保持 net9.0：Avalonia 11.2.5 官方测试矩阵覆盖 net8 / net9，
      net10.0 与 Avalonia 11.2.x 组合曾遇启动崩，保留 net9 更稳。
      Update 项目独立，与主 App (net10.0-windows) TargetFramework 不一致不互相影响。
    -->
    <TargetFramework>net9.0</TargetFramework>
    <ApplicationIcon>..\BlackGoldAncientSword.Resources\Images\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0.0</Version>
    <AssemblyName>BlackGoldAncientSword.Update</AssemblyName>
    <RootNamespace>BlackGoldAncientSword.Update</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- 发布参数：CI/installer 调用 dotnet publish 时自动应用。
       self-contained = 不依赖客户机已装 .NET runtime，
       PublishSingleFile + IncludeNativeLibrariesForSelfExtract = 单 exe 自宿主，
       EnableCompressionInSingleFile = 压缩内嵌 runtime 减体积。 -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Avalonia 11.x：跨平台 UI 框架。仅桌面 + Fluent 主题，
      不引 Avalonia.Diagnostics（DevTools），减体积。
    -->
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
  </ItemGroup>

</Project>
