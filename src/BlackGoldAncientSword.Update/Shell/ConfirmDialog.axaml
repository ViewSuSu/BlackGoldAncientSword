<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BlackGoldAncientSword.Update.Shell.ConfirmDialog"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Title="提示">
    <Border Padding="20,18"
            Background="#2B2B2B"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              OffsetX="0"
                              OffsetY="2"
                              Opacity="0.45"
                              Color="Black" />
        </Border.Effect>
        <Grid RowDefinitions="Auto,Auto,Auto">
            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       Margin="0,0,0,10"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#F0F0F0"
                       Text="提示" />
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="0,0,0,18"
                       FontSize="12"
                       Foreground="#C8C8C8"
                       TextWrapping="Wrap"
                       Text="..." />
            <StackPanel x:Name="ButtonsPanel"
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button x:Name="CancelButton"
                        MinWidth="80"
                        Padding="14,6"
                        Background="#3A3A3A"
                        BorderBrush="#4A4A4A"
                        Foreground="#E0E0E0"
                        Content="取消"
                        Click="OnCancelClick" />
                <Button x:Name="OkButton"
                        MinWidth="80"
                        Padding="14,6"
                        Background="#0E639C"
                        BorderBrush="#1177BB"
                        Foreground="White"
                        Content="确定"
                        Click="OnOkClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
