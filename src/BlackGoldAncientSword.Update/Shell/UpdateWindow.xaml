<Window
    x:Class="BlackGoldAncientSword.Update.Shell.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="BlackGoldAncientSword 在线更新"
    Width="520"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    SizeToContent="Height"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Border
        Padding="18,16"
        Background="#2B2B2B"
        BorderBrush="#3A3A3A"
        BorderThickness="1"
        CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="20"
                Direction="270"
                Opacity="0.45"
                ShadowDepth="2"
                Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题  -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#F0F0F0"
                    Text="正在更新 BlackGoldAncientSword" />
                <Button
                    x:Name="CloseButton"
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    Content="✕"
                    Foreground="#AAAAAA"
                    ToolTip="取消更新" />
            </Grid>

            <!--  状态文字  -->
            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,8"
                FontSize="12"
                Foreground="#C0C0C0"
                Text="{Binding StatusText}"
                TextWrapping="Wrap" />

            <!--  进度条：HandyControl 默认样式  -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <ProgressBar
                    Height="15"
                    BorderThickness="0"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Maximum="100"
                    Minimum="0"
                    Style="{StaticResource ProgressBarBaseStyle}"
                    Value="{Binding Percent, Mode=OneWay}" />
            </Grid>

            <!--  详细信息行：速度 | 大小 | 剩余时间 | 百分比  -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="12"
                        Foreground="#90CAF9"
                        Text="{Binding SpeedText}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        FontSize="12"
                        Foreground="#A0A0A0"
                        Text="{Binding SizeText}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        FontSize="12"
                        Foreground="#A0A0A0"
                        Text="{Binding EtaText}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#E0E0E0"
                    Text="{Binding PercentText}" />
            </Grid>
        </Grid>
    </Border>
</Window>
