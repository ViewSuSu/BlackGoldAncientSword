<Window
    x:Class="BlackGoldAncientSword.Update.Shell.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="BlackGoldAncientSword 在线更新"
    Width="560"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Microsoft YaHei UI, Segoe UI"
    Icon="/Images/updater.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    SizeToContent="Height"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    Left="-10000"
    Top="-10000">

    <!--  设计语义 token：集中维护浅色主题下的色彩、字号与节奏，避免硬编码散落各处  -->
    <Window.Resources>
        <!--  外层窗体：纯白 → 极浅冷灰 对角渐变，营造柔和纸面质感  -->
        <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="1" Color="#F2F4F8" />
        </LinearGradientBrush>

        <!--  内描边：浅灰过渡，强化卡片边缘但不喧宾夺主  -->
        <LinearGradientBrush x:Key="StrokeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#E6E8EE" />
            <GradientStop Offset="1" Color="#D5D8E0" />
        </LinearGradientBrush>

        <!--  进度条填充：青→蓝→紫 三色渐变，在白底上仍醒目，符合 contrast-data ≥3:1  -->
        <LinearGradientBrush x:Key="ProgressFillBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#29B6F6" />
            <GradientStop Offset="0.55" Color="#5C6BC0" />
            <GradientStop Offset="1" Color="#AB47BC" />
        </LinearGradientBrush>

        <!--  进度条轨道：浅灰半透叠层，与 ProgressBarBaseStyle 默认背景叠加保证可视感  -->
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="#0F000000" />

        <!--  正文文字 ≥4.5:1 对比；次级 ≥4.5:1；muted ≥3:1，满足 WCAG AA  -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E11D48" />

        <!--  关闭按钮：默认透明、悬停浅红高亮、按下加深；动画 150ms 符合 micro-interaction 时序  -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE4E6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FECDD3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--  外层边框：渐变 surface + 渐变 stroke + 立体阴影，营造玻璃质感  -->
    <Border
        Margin="14"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource StrokeBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <!--  柔和大范围阴影：浅色主题用低透明度墨黑，营造悬浮感而不发灰  -->
            <DropShadowEffect
                BlurRadius="28"
                Direction="270"
                Opacity="0.18"
                ShadowDepth="3"
                Color="#0F172A" />
        </Border.Effect>

        <Grid Margin="24,20,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题栏  -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  App 图标 + 标题：左侧主体  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="28"
                        Height="28"
                        Margin="0,0,12,0"
                        Background="#EEF2FA"
                        CornerRadius="7">
                        <Image
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="/Images/updater.ico"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="BlackGoldAncientSword" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="在线更新" />
                    </StackPanel>
                </StackPanel>

                <!--  右上按钮组：最小化 + 关闭  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  最小化按钮  -->
                    <Button
                        x:Name="MinimizeButton"
                        Width="28"
                        Height="28"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Click="MinimizeButton_Click"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="最小化">
                        <Path
                            Width="10"
                            Height="10"
                            Data="M0,5 H10"
                            Stroke="{StaticResource TextSecondaryBrush}"
                            StrokeThickness="1.4" />
                    </Button>
                    <!--  关闭按钮  -->
                    <Button
                        x:Name="CloseButton"
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="取消更新">
                        <Image
                            Width="18"
                            Height="18"
                            Source="/Images/close.png"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  状态行  -->
            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,12"
                FontSize="13"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="{Binding StatusText}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <!--  进度条：HandyControl 默认样式 + 渐变填充 + 圆角轨道  -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <!--  自绘轨道背景：HC 默认样式背景在暗主题下偏深，叠一层圆角浅色块提升对比  -->
                <Border
                    Height="15"
                    Background="{StaticResource ProgressTrackBrush}"
                    CornerRadius="7.5" />
                <ProgressBar
                    Height="15"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource ProgressFillBrush}"
                    Maximum="100"
                    Minimum="0"
                    Style="{StaticResource ProgressBarBaseStyle}"
                    Value="{Binding Percent, Mode=OneWay}" />
            </Grid>

            <!--  详情行：速度 | 大小 | ETA  -->
            <StackPanel
                Grid.Row="3"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource AccentBrush}"
                    Text="{Binding SpeedText}"
                    Typography.NumeralAlignment="Tabular" />
                <TextBlock
                    Margin="10,0,10,0"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="·" />
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="{Binding SizeText}"
                    Typography.NumeralAlignment="Tabular" />
                <TextBlock
                    Margin="10,0,10,0"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="·" />
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="{Binding EtaText}"
                    Typography.NumeralAlignment="Tabular" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
