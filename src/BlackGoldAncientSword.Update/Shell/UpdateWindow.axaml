<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BlackGoldAncientSword.Update.ViewModels"
        x:Class="BlackGoldAncientSword.Update.Shell.UpdateWindow"
        x:DataType="vm:UpdateViewModel"
        Title="BlackGoldAncientSword 在线更新"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
    <Border Padding="18,16"
            Background="#2B2B2B"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            CornerRadius="8"
            PointerPressed="OnRootPointerPressed">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              OffsetX="0"
                              OffsetY="2"
                              Opacity="0.45"
                              Color="Black" />
        </Border.Effect>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">

            <!-- 标题 + 关闭按钮 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#F0F0F0"
                           Text="正在更新 BlackGoldAncientSword" />
                <Button x:Name="CloseButton"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#AAAAAA"
                        Content="✕"
                        ToolTip.Tip="取消更新"
                        Click="CloseButton_Click" />
            </Grid>

            <!-- 状态文字 -->
            <TextBlock Grid.Row="1"
                       Margin="0,0,0,8"
                       FontSize="12"
                       Foreground="#C0C0C0"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap" />

            <!-- 进度条 -->
            <ProgressBar Grid.Row="2"
                         Height="15"
                         Margin="0,0,0,10"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Percent, Mode=OneWay}" />

            <!-- 详细信息：速度 | 大小 | 剩余时间 | 百分比 -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock FontSize="12"
                               Foreground="#90CAF9"
                               Text="{Binding SpeedText}" />
                    <TextBlock Margin="10,0,0,0"
                               FontSize="12"
                               Foreground="#A0A0A0"
                               Text="{Binding SizeText}" />
                    <TextBlock Margin="10,0,0,0"
                               FontSize="12"
                               Foreground="#A0A0A0"
                               Text="{Binding EtaText}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#E0E0E0"
                           Text="{Binding PercentText}" />
            </Grid>
        </Grid>
    </Border>
</Window>
