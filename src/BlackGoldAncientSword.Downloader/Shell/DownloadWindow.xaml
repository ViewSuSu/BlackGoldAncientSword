<Window
    x:Class="BlackGoldAncientSword.Downloader.Shell.DownloadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:conv="clr-namespace:BlackGoldAncientSword.Downloader.Converters"
    Title="BlackGoldAncientSword 安装包下载器"
    Width="640"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Microsoft YaHei UI, Segoe UI, Inter"
    Icon="/Images/downloader.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    SizeToContent="Height"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    Topmost="False"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <!--
        设计 token（Fluent 2 / Windows 11 2025 refresh / File Explorer copy dialog 风格）：
          - 纯白 surface + 单色蓝→靛蓝渐变主色，无多色噪声
          - 主进度 12h pill + gloss + glow + shimmer sweep（Battle.net-style layered gradients）
          - 副进度 3h capsule 极简
          - 主百分数 inline 到主进度条右侧（22pt SemiBold Tabular）
          - 去掉「总进度 / 当前文件」等冗余 label，去掉进度条内嵌百分数文字
    -->
    <Window.Resources>

        <!--  ============ Surfaces  ============  -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="BorderBrush_Soft" Color="#E5E7EB" />
        <SolidColorBrush x:Key="BorderBrush_Cell" Color="#E2E8F0" />

        <!--  ============ Text  ============  -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#475569" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

        <!--  ============ Brand  ============  -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />

        <!--  主进度渐变：与 Update 层一致（青 → 蓝 → 紫 三色渐变）  -->
        <LinearGradientBrush x:Key="ProgressFillBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#29B6F6" />
            <GradientStop Offset="0.55" Color="#5C6BC0" />
            <GradientStop Offset="1" Color="#AB47BC" />
        </LinearGradientBrush>

        <!--  主进度轨道：Update 层 #0F000000 浅色半透（叠层展现层次）  -->
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="#0F000000" />

        <!--  副进度：比主进度低调，但对比度足够 —— 之前 #F1F5F9 track 在浅色底几乎不可见  -->
        <SolidColorBrush x:Key="SubProgressFillBrush" Color="#64748B" />
        <SolidColorBrush x:Key="SubProgressTrackBrush" Color="#E5E7EB" />

        <!--  ============ Danger  ============  -->
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="DangerBgBrush" Color="#FEF2F2" />
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#FCA5A5" />

        <!--  ============ Converters  ============  -->
        <conv:BoolToVisibilityConverter x:Key="Bool2Visibility" />
        <conv:BoolToVisibilityInverseConverter x:Key="Bool2VisibilityRe" />

        <!--  ============ 关闭按钮  ============  -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE4E6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FECDD3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ============ 底部按钮：Fluent 次要按钮  ============  -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ============ 主按钮：错误态"重试"  ============  -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ============ Stat cell 样式  ============  -->
        <Style x:Key="StatCellStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush_Cell}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="MinHeight" Value="62" />
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </Window.Resources>

    <!--  外壳：纯白卡片 + Fluent 大阴影  -->
    <Border
        Margin="14"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource BorderBrush_Soft}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="40"
                Direction="270"
                Opacity="0.10"
                ShadowDepth="8"
                Color="#0F172A" />
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  R0 品牌栏  -->
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <!--  R2 Phase 行  -->
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <!--  R4 主进度 + inline 百分数  -->
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <!--  R6 当前文件名 + 副进度  -->
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <!--  R8 4-stat grid  -->
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <!--  R10 底部  -->
            </Grid.RowDefinitions>

            <!--  ===== R0 品牌栏 =====  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="34"
                        Height="34"
                        Margin="0,0,12,0"
                        Background="#EEF2FA"
                        CornerRadius="9">
                        <Image
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="/Images/downloader.ico"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="BlackGoldAncientSword" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="安装包下载器" />
                    </StackPanel>
                </StackPanel>

                <!--  版本 pill  -->
                <Border
                    Grid.Column="2"
                    Margin="0,0,12,0"
                    Padding="10,4"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource BorderBrush_Cell}"
                    BorderThickness="1"
                    CornerRadius="999"
                    Visibility="{Binding HasVersionTag, Converter={StaticResource Bool2Visibility}}">
                    <TextBlock
                        FontFamily="Consolas, Menlo, Microsoft YaHei UI"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding VersionTag}"
                        Typography.NumeralAlignment="Tabular" />
                </Border>

                <!--  关闭按钮  -->
                <Button
                    x:Name="CloseButton"
                    Grid.Column="3"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click"
                    IsEnabled="{Binding IsCancelEnabled}"
                    Style="{StaticResource CloseButtonStyle}"
                    ToolTip="取消下载并关闭">
                    <Image
                        Width="18"
                        Height="18"
                        Source="/Images/close.png"
                        Stretch="Uniform" />
                </Button>
            </Grid>

            <!--  ===== R2 Phase 行（正常态） =====  -->
            <Grid
                Grid.Row="2"
                Visibility="{Binding IsNormal, Converter={StaticResource Bool2Visibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        x:Name="PhaseDot"
                        Width="8"
                        Height="8"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Fill="{StaticResource PrimaryBrush}" />
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{Binding PhaseText}" />
                </StackPanel>

                <Border
                    Grid.Column="2"
                    Padding="12,4"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceMutedBrush}"
                    BorderBrush="{StaticResource BorderBrush_Cell}"
                    BorderThickness="1"
                    CornerRadius="999"
                    Visibility="{Binding HasFileIndex, Converter={StaticResource Bool2Visibility}}">
                    <TextBlock
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding FileIndexText}"
                        Typography.NumeralAlignment="Tabular" />
                </Border>
            </Grid>

            <!--
                ===== R4 主进度：与 Update 层完全一致 =====
                  - 高 15px 圆角 7.5（Border 自绘 track）
                  - ProgressBar 用 HC ProgressBarBaseStyle：Foreground 承接青→蓝→紫渐变
                  - 百分数由 HC 样式内嵌在轨道正中央，无外部大字重复
            -->
            <Grid
                x:Name="MainProgressHost"
                Grid.Row="4"
                Visibility="{Binding IsNormal, Converter={StaticResource Bool2Visibility}}">
                <Border
                    Height="15"
                    Background="{StaticResource ProgressTrackBrush}"
                    CornerRadius="7.5" />
                <ProgressBar
                    Height="15"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource ProgressFillBrush}"
                    IsIndeterminate="{Binding IsIndeterminate}"
                    Maximum="100"
                    Minimum="0"
                    Style="{StaticResource ProgressBarBaseStyle}"
                    Value="{Binding Percent, Mode=OneWay}" />
            </Grid>

            <!--  ===== R6 当前文件名 + 5h 副进度（capsule，无内嵌百分数，Fill 单色低调） =====  -->
            <StackPanel
                x:Name="SubProgressHost"
                Grid.Row="6"
                Visibility="{Binding HasCurrentFile, Converter={StaticResource Bool2Visibility}}">
                <TextBlock
                    Margin="0,0,0,8"
                    FontFamily="Consolas, Menlo, Microsoft YaHei UI"
                    FontSize="12"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="{Binding CurrentFileName}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding CurrentFileName}" />
                <Grid Height="5">
                    <Border Background="{StaticResource SubProgressTrackBrush}" CornerRadius="2.5" />
                    <!--
                        副进度条走完全自绘 Template：HC 全局主题会覆盖默认 ProgressBar 并叠内嵌百分数，
                        这里手写 PART_Indicator + PART_Track 强制去除文字层。
                    -->
                    <ProgressBar
                        Height="5"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource SubProgressFillBrush}"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding CurrentFilePercent, Mode=OneWay}">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid ClipToBounds="True">
                                    <Border x:Name="PART_Track" Background="Transparent" />
                                    <Border
                                        x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="2.5" />
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </Grid>
            </StackPanel>

            <!--  ===== R8 4-stat grid =====  -->
            <Grid
                Grid.Row="8"
                Visibility="{Binding IsNormal, Converter={StaticResource Bool2Visibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCellStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="速度" />
                        <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding SpeedText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatCellStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="已下载" />
                        <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding DownloadedText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource StatCellStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="总大小" />
                        <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding TotalSizeText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource StatCellStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="剩余时间" />
                        <TextBlock Style="{StaticResource StatValueStyle}" Text="{Binding EtaText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ===== R2/R4/R6/R8 错误态覆盖（占用 R2..R8 整个中央区） =====  -->
            <Border
                Grid.Row="2"
                Grid.RowSpan="7"
                Padding="18,16"
                Background="{StaticResource DangerBgBrush}"
                BorderBrush="{StaticResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding IsError, Converter={StaticResource Bool2Visibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Path
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Width="22"
                        Height="22"
                        Margin="0,2,14,0"
                        VerticalAlignment="Top"
                        Data="M12 2 L22 20 L2 20 Z M12 9 L12 14 M12 16.5 L12 17.5"
                        Stretch="Uniform"
                        Stroke="{StaticResource DangerBrush}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="2" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DangerBrush}"
                        Text="下载失败" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!--  ===== R10 底部行动区 =====  -->
            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    MaxWidth="380"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="{Binding BottomHintText}"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        x:Name="CancelButton"
                        MinWidth="96"
                        Click="CancelButton_Click"
                        Content="取消下载"
                        IsEnabled="{Binding IsCancelEnabled}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="{Binding IsError, Converter={StaticResource Bool2VisibilityRe}}" />
                    <Button
                        x:Name="RetryButton"
                        MinWidth="96"
                        Click="RetryButton_Click"
                        Content="重试"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Visibility="{Binding IsError, Converter={StaticResource Bool2Visibility}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
