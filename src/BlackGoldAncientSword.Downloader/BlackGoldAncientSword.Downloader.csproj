<Project Sdk="Microsoft.NET.Sdk">

  <!--
    设计原则：本项目完全独立，绝不引用 App / Framework / Modules / Update / Resources 等其它项目。
    原因：Downloader 定位为「离线安装包下载器」，仅面向 Gitee release 拉取分卷安装包并拉起 Inno Setup 安装向导。
    独立发布物：以 self-contained single-file 形式 dotnet publish，产物可拷到任意干净目录直接双击运行。
  -->

  <PropertyGroup>
    <Authors>小窗同学</Authors>
    <PackageProjectUrl>https://github.com/ViewSuSu</PackageProjectUrl>
    <Company>$(Authors)</Company>
    <Description>BlackGoldAncientSword 离线安装包下载器</Description>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Images\downloader.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0.0</Version>
    <AssemblyName>BlackGoldAncientSword.Downloader</AssemblyName>
    <RootNamespace>BlackGoldAncientSword.Downloader</RootNamespace>
  </PropertyGroup>

  <!-- 发布参数：dotnet publish 时直接命中，无需额外 -p 参数 -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      只引 NuGet 包，不引项目，保持 Downloader 独立。
      版本与主项目 Framework.csproj / Update.csproj 保持一致：HandyControl 3.5.0。
    -->
    <PackageReference Include="HandyControl" Version="3.5.0" />
  </ItemGroup>

  <!--
    Downloader 自带一份图标资源，与主程序视觉刻意区分（避免与 App 主程序共用同一图标）：
    - Images/downloader.ico：📥 下载托盘图标（Fluent Emoji, MIT）——窗口标题栏图标（Window.Icon）+ exe 文件图标（ApplicationIcon）
    - Images/close.png：右上角自绘关闭按钮图标
    设计上不引用 BlackGoldAncientSword.Resources 项目，保留 Downloader 零项目引用的独立性。
  -->
  <ItemGroup>
    <Resource Include="Images\downloader.ico" />
    <Resource Include="Images\close.png" />
  </ItemGroup>

</Project>
